--// TORNADO // aim, click, a tornado forms there. players running the hub get pulled in and spun around it (timed, no damage)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local lp = Players.LocalPlayer
local Fx = (getgenv and getgenv().SpellsFx) or { viewerOnly = false, config = {}, register = function() end, unregister = function() end, emit = function() end, push = function() end, status = function() end, cast = function() end, softPush = function() return false end, playerAt = function() return nil end, playerFromInstance = function() return nil end, playersInRadius = function() return {} end, vec = function(v) return { x = v.X, y = v.Y, z = v.Z } end, unvec = function(t) if type(t) == "table" and type(t.x) == "number" and type(t.y) == "number" and type(t.z) == "number" then return Vector3.new(t.x, t.y, t.z) end return nil end, ready = function() return false end }
local VIEWER = Fx.viewerOnly == true
local FX_PATH = Fx.currentPath
local env = (getgenv and getgenv()) or _G
local NAME = "tornado"
if not VIEWER and env.__TornadoStop then pcall(env.__TornadoStop) end

local CFG = { cooldown = 8, life = 6, radius = 24, height = 46, spin = 3.2, spinRadius = 11, spinUp = 3.5, pullSpeed = 14 }

local folder = Instance.new("Folder")
folder.Name = "TornadoFX"
folder.Parent = workspace

local function newPart(size, color, transp)
	local p = Instance.new("Part")
	p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
	p.Material = Enum.Material.SmoothPlastic
	p.Color = color
	p.Transparency = transp
	p.Size = size
	return p
end

local function playVisual(pos)
	local model = Instance.new("Model")
	model.Parent = folder
	local layers = {}
	for i = 1, 14 do
		local a = (i - 1) / 13
		local w = 4 + a * CFG.radius * 0.9
		local ring = newPart(Vector3.new(CFG.height / 14 + 0.4, w, w), Color3.fromRGB(190, 195, 205):Lerp(Color3.fromRGB(110, 115, 125), a), 0.45 + 0.2 * a)
		ring.Shape = Enum.PartType.Cylinder
		ring.Parent = model
		layers[i] = { part = ring, a = a }
	end
	local debris = {}
	for i = 1, 16 do
		local d = newPart(Vector3.new(math.random(1, 3), math.random(1, 2), math.random(1, 3)), Color3.fromRGB(90, 80, 65), 0)
		d.Parent = model
		debris[i] = { part = d, ang = math.random() * math.pi * 2, h = math.random(), spd = 2 + math.random() * 2 }
	end
	local snd = Instance.new("Sound")
	snd.SoundId = "rbxassetid://9125626350"
	snd.Looped, snd.Volume, snd.PlaybackSpeed = true, 0.6, 0.8
	local anchor = newPart(Vector3.one, Color3.new(), 1)
	anchor.CFrame = CFrame.new(pos)
	anchor.Parent = model
	snd.Parent = anchor
	pcall(function() snd:Play() end)
	task.spawn(function()
		local t0 = os.clock()
		local conn
		conn = RunService.Heartbeat:Connect(function()
			local t = os.clock() - t0
			if t > CFG.life or not model.Parent then
				conn:Disconnect()
				model:Destroy()
				return
			end
			local grow = math.clamp(t / 0.8, 0, 1) * math.clamp((CFG.life - t) / 0.8, 0, 1)
			for i, l in ipairs(layers) do
				local y = pos.Y + (i - 0.5) * (CFG.height / 14) * grow
				local sway = math.sin(t * 2 + i * 0.4) * (1 + l.a * 3)
				l.part.Size = Vector3.new(CFG.height / 14 + 0.4, (4 + l.a * CFG.radius * 0.9) * grow + 0.1, (4 + l.a * CFG.radius * 0.9) * grow + 0.1)
				l.part.CFrame = CFrame.new(pos.X + sway, y, pos.Z + math.cos(t * 1.7 + i * 0.4) * (1 + l.a * 2)) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(t * (2 + l.a), 0, 0)
			end
			for _, d in ipairs(debris) do
				d.ang += d.spd * 0.02
				d.h = (d.h + 0.004 * d.spd) % 1
				local r = (3 + d.h * CFG.radius * 0.6) * grow
				d.part.CFrame = CFrame.new(pos.X + math.cos(d.ang) * r, pos.Y + d.h * CFG.height * grow, pos.Z + math.sin(d.ang) * r) * CFrame.Angles(d.ang, d.ang * 2, 0)
			end
		end)
		task.delay(CFG.life + 0.2, function()
			pcall(function() snd:Stop() end)
		end)
	end)
end

local last = 0
local function cast()
	if os.clock() - last < CFG.cooldown then return end
	local mouse = lp:GetMouse()
	local hit = mouse.Hit
	if not hit then return end
	last = os.clock()
	local pos = hit.Position
	playVisual(pos)
	task.spawn(function()
		local t0 = os.clock()
		Fx.emit(NAME, "cast", { pos = Fx.vec(pos) })
		while os.clock() - t0 < CFG.life - 0.5 and folder.Parent do
			Fx.cast(NAME .. "_hit", pos, { radius = CFG.radius, pull = CFG.pullSpeed, pullTime = 0.8, spin = CFG.spin, spinRadius = CFG.spinRadius, spinUp = CFG.spinUp, spinTime = 3, novis = true })
			task.wait(0.5)
		end
	end)
end

local function give()
	local bp = lp:FindFirstChildOfClass("Backpack") or lp:WaitForChild("Backpack", 10)
	if not bp or bp:FindFirstChild("Tornado") or (lp.Character and lp.Character:FindFirstChild("Tornado")) then return end
	local tool = Instance.new("Tool")
	tool.Name = "Tornado"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool:SetAttribute("TornadoTool", true)
	tool.Activated:Connect(cast)
	tool.Parent = bp
end

Fx.register(NAME, function(pkt)
	local pos = type(pkt.d) == "table" and Fx.unvec(pkt.d.pos)
	if pos then playVisual(pos) end
end, FX_PATH)
if VIEWER then return end

give()
local charConn = lp.CharacterAdded:Connect(function()
	task.wait(1)
	give()
end)
env.__TornadoStop = function()
	pcall(Fx.unregister, NAME)
	charConn:Disconnect()
	for _, holder in ipairs({ lp:FindFirstChildOfClass("Backpack"), lp.Character }) do
		if holder then
			for _, d in ipairs(holder:GetChildren()) do
				if d:IsA("Tool") and d:GetAttribute("TornadoTool") then pcall(function() d:Destroy() end) end
			end
		end
	end
	pcall(function() folder:Destroy() end)
	env.__TornadoStop = nil
end
