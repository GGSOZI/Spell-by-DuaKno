local function report(tag, err)
	local msg = tostring(err)
	warn("[Snowgrave] " .. tag .. ": " .. msg)
	notify(tag .. ": " .. msg:sub(1, 200))
end

-- ===================== NETWORK OWNERSHIP + SIMULATION RADIUS =====================
local function simBoost()
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)
	pcall(function() lp.MaximumSimulationRadius = math.huge end)
	pcall(function() if setsimulationradius then setsimulationradius(math.huge, math.huge) end end)
end
simBoost()
do
	local acc = 0
	conn(RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 1 then
			acc = 0
			simBoost()
		end
	end))
end

-- ===================== GETTING THE TOOL =====================
local function findTool(objs)
	for _, o in ipairs(objs) do
		if typeof(o) == "Instance" then
			if o:IsA("Tool") then return o end
			local t = o:FindFirstChildWhichIsA("Tool", true)
			if t then return t end
		end
	end
	return nil
end

local function fetch(id)
	local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
	if not ok or type(objs) ~= "table" or #objs == 0 then
		ok, objs = pcall(function() return { InsertService:LoadAsset(id) } end)
	end
	if not ok or type(objs) ~= "table" then return nil end
	return findTool(objs)
end

local function strip(tool)
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then pcall(function() d:Destroy() end) end
	end
end

local function buildFallback()
	local tool = Instance.new("Tool")
	tool.Name = CFG.toolName
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = "Snowgrave"
	tool.GripPos = Vector3.new(0, -1.2, 0)
	local h = Instance.new("Part")
	h.Name = "Handle"
	h.Size = Vector3.new(0.5, 3.4, 0.5)
	h.Material = Enum.Material.Ice
	h.Color = Color3.fromRGB(170, 225, 255)
	h.Transparency = 0.15
	h.CanCollide = false
	h.Parent = tool
	local gem = Instance.new("Part")
	gem.Name = "Gem"
	gem.Shape = Enum.PartType.Ball
	gem.Size = Vector3.new(1.1, 1.1, 1.1)
	gem.Material = Enum.Material.Neon
	gem.Color = Color3.fromRGB(190, 240, 255)
	gem.CanCollide = false
	gem.Massless = true
	gem.CFrame = h.CFrame * CFrame.new(0, 1.9, 0)
	gem.Parent = tool
	local w = Instance.new("WeldConstraint")
	w.Part0 = h
	w.Part1 = gem
	w.Parent = gem
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 230, 255)
	light.Range = 10
	light.Brightness = 2
	light.Parent = gem
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dng"
	pe.Rate = 12
	pe.Lifetime = NumberRange.new(0.6, 1)
	pe.Speed = NumberRange.new(1, 3)
	pe.Size = NumberSequence.new(0.35, 0)
	pe.LightEmission = 1
	pe.Color = ColorSequence.new(Color3.fromRGB(200, 240, 255))
	pe.Parent = gem
	return tool
end

local template, source
for i, id in ipairs(CFG.assets) do
	local t = fetch(id)
	if t then
		strip(t)
		if t:FindFirstChild("Handle") or not t.RequiresHandle then
			template, source = t, "asset " .. i
			break
		end
		t:Destroy()
	end
end
if not template then
	template, source = buildFallback(), "built-in staff"
end
template:SetAttribute("SnowgraveTool", true)
if template.Name == "" then template.Name = CFG.toolName end
notify("Loaded: " .. source .. " + Iceshock. Click to cast.")

