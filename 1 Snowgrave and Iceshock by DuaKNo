local function newFlake(pos, vel, size, life, spin, sway)
	if #flakes > 60 then return end
	local part = fxPart({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(pos) })
	local holder, bars = buildFlakeGui(part, size)
	flakes[#flakes + 1] = {
		part = part, holder = holder, bars = bars, p0 = pos, vel = vel, life = life,
		t = 0, rot = rng:NextNumber(0, 360), spin = spin, amp = sway,
		sw = rng:NextNumber(2, 5), ph = rng:NextNumber(0, 6.28),
	}
end

conn(RunService.Heartbeat:Connect(function(dt)
	for i = #flakes, 1, -1 do
		local f = flakes[i]
		f.t += dt
		if not alive or f.t >= f.life or not f.part.Parent then
			pcall(function() f.part:Destroy() end)
			table.remove(flakes, i)
		else
			local k = f.t
			local sway = Vector3.new(math.sin(k * f.sw + f.ph) * f.amp, 0, math.cos(k * f.sw + f.ph) * f.amp)
			f.part.CFrame = CFrame.new(f.p0 + f.vel * k + sway)
			f.rot += f.spin * dt
			f.holder.Rotation = f.rot
			local fade = f.life - k
			if fade < 0.3 then
				local a = 1 - math.clamp(fade / 0.3, 0, 1)
				for _, b in ipairs(f.bars) do b.BackgroundTransparency = a end
			end
		end
	end
end))

