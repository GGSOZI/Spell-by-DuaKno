-- ===================== LOOSE (UNANCHORED) PARTS: freeze, then fly away =====================
CFG.freezeLoose = true -- unanchored parts in the beam radius freeze, then get launched
CFG.looseFreeze = 2.2 -- seconds they stay frozen before flying away
CFG.looseFling = 130 -- sideways launch speed (away from the beam)
CFG.looseLift = 90 -- upward launch speed
CFG.looseMax = 120 -- max assemblies affected per cast (lag guard)
local looseBusy = {}

local function looseOK(p)
	if not p:IsA("BasePart") or p:IsA("Terrain") or p.Anchored then return false end
	if fxFolder and p:IsDescendantOf(fxFolder) then return false end
	if p:GetAttribute("_Replay") then return false end
	if lp.Character and p:IsDescendantOf(lp.Character) then return false end
	if p.Size.Magnitude > 60 then return false end
	local m = p:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(m) then return false end
		m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
	end
	return true
end

local function freezeLoose(root, from, dur, lite)
	if looseBusy[root] or not root.Parent or root.Anchored then return end
	looseBusy[root] = true
	simBoost()
	local saved, k = {}, 0
	local okP, parts = pcall(function() return root:GetConnectedParts(true) end)
	if not okP or type(parts) ~= "table" then parts = { root } end
	local mn, mx
	for _, q in ipairs(parts) do
		if k >= 25 then break end
		k += 1
		saved[q] = { q.Color, q.Material }
		pcall(function()
			q.Material = Enum.Material.Ice
			q.Color = ICE
		end)
		local r = q.Size.Magnitude / 2
		local a, b = q.Position - Vector3.new(r, r, r), q.Position + Vector3.new(r, r, r)
		mn = mn and Vector3.new(math.min(mn.X, a.X), math.min(mn.Y, a.Y), math.min(mn.Z, a.Z)) or a
		mx = mx and Vector3.new(math.max(mx.X, b.X), math.max(mx.Y, b.Y), math.max(mx.Z, b.Z)) or b
	end
	local function restore()
		for q, sv in pairs(saved) do
			pcall(function()
				if q.Parent then
					q.Color = sv[1]
					q.Material = sv[2]
				end
			end)
		end
	end
	-- ice cage around it
	local cage
	pcall(function()
		local size = Vector3.new(
			math.clamp(mx.X - mn.X, 2, 30),
			math.clamp(mx.Y - mn.Y, 2, 30),
			math.clamp(mx.Z - mn.Z, 2, 30)
		)
		cage = iceCage(CFrame.new((mn + mx) / 2), size, lite or size.Magnitude < 9)
	end)
	local cf = root.CFrame
	local dir = Vector3.new(root.Position.X - from.X, 0, root.Position.Z - from.Z)
	if dir.Magnitude > 0.1 then
		dir = dir.Unit
	else
		dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
	end
	local released = false
	local hold
	local function release(fling)
		if released then return end
		released = true
		if hold then hold:Disconnect() end
		looseBusy[root] = nil
		if cage then pcall(cage, fling) end
		if fling and root.Parent then
			simBoost()
			pcall(function()
				root.AssemblyLinearVelocity = dir * CFG.looseFling + Vector3.new(0, CFG.looseLift, 0)
				root.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-12, 12), rng:NextNumber(-12, 12), rng:NextNumber(-12, 12))
			end)
			task.delay(1.5, restore) -- stays icy while it flies
		else
			restore()
		end
	end
	hold = RunService.Heartbeat:Connect(function()
		if not alive or not root.Parent then
			release(false)
			return
		end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = cf
	end)
	task.delay(dur or CFG.looseFreeze, function() release(alive) end)
end

local function hitLoose(pos, rad, dur)
	if not CFG.freezeLoose then return end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { fxFolder }
	if lp.Character then ignore[#ignore + 1] = lp.Character end
	params.FilterDescendantsInstances = ignore
	local roots, n = {}, 0
	for _, p in ipairs(workspace:GetPartBoundsInRadius(pos, rad or CFG.radius, params)) do
		if looseOK(p) then
			local r = p.AssemblyRootPart
			if r and not r.Anchored and not looseBusy[r] and not roots[r] and n < CFG.looseMax then
				roots[r] = true
				n += 1
			end
		end
	end
	for r in pairs(roots) do
		task.delay(rng:NextNumber(0.1, 0.6), function()
			if alive then pcall(freezeLoose, r, pos, dur, n > 25) end
		end)
	end
end

