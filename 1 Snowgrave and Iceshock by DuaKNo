local fxFolder = Instance.new("Folder")
fxFolder.Name = "SnowgraveFX"
fxFolder.Parent = workspace

local function fxPart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	for k, v in pairs(props) do p[k] = v end
	p.Parent = fxFolder
	return p
end

local ICE = Color3.fromRGB(190, 235, 255)
local rng = Random.new()

local function tween(inst, t, goal, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), goal)
	tw:Play()
	return tw
end

local function shakeCamera(power, dur)
	if not CFG.shake then return end
	local cam = workspace.CurrentCamera
	if not cam then return end
	local t0 = os.clock()
	local name = "SnowgraveShake" .. tostring(t0)
	RunService:BindToRenderStep(name, Enum.RenderPriority.Camera.Value + 2, function()
		local k = 1 - (os.clock() - t0) / dur
		if k <= 0 then
			RunService:UnbindFromRenderStep(name)
			return
		end
		cam.CFrame = cam.CFrame * CFrame.new(rng:NextNumber(-1, 1) * power * k, rng:NextNumber(-1, 1) * power * k, 0)
	end)
end

local function skyTint()
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SnowgraveTint"
	cc.Parent = Lighting
	tween(cc, 0.35, { TintColor = Color3.fromRGB(232, 243, 255), Brightness = 0.04, Saturation = -0.08 })
	task.delay(CFG.freezeTime + 0.6, function()
		tween(cc, 1.2, { TintColor = Color3.new(1, 1, 1), Brightness = 0, Saturation = 0 })
		Debris:AddItem(cc, 1.4)
	end)
end

