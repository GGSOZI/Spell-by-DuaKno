local function getArms(char)
	local arms = {}
	local function norm(n) return (n:lower():gsub("[%s_]", "")) end
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Motor6D") and d.Part1 and d.Part1:IsDescendantOf(char) and not d:FindFirstAncestorOfClass("Tool") then
			local n, p = norm(d.Name), norm(d.Part1.Name)
			if n == "rightshoulder" or p == "rightarm" or p == "rightupperarm" then
				arms.r = arms.r or d
			elseif n == "leftshoulder" or p == "leftarm" or p == "leftupperarm" then
				arms.l = arms.l or d
			end
		end
	end
	if arms.r and arms.l then return arms end
	return nil
end

