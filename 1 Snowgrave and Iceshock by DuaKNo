	local th = rng:NextNumber(0, math.pi * 2)
	local dir = rng:NextNumber() < 0.5 and 1 or -1
	local part = fxPart({
		Transparency = 1,
		Size = Vector3.new(0.2, 0.2, 0.2),
		CFrame = CFrame.new(top + Vector3.new(math.cos(th) * r, 0, math.sin(th) * r)),
	})
	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 3.8, 0)
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -3.8, 0)
	a1.Parent = part
	local tr = Instance.new("Trail")
	tr.Attachment0, tr.Attachment1 = a0, a1
	tr.Lifetime = 0.45
	tr.MinLength = 0.05
	tr.FaceCamera = true
	tr.LightEmission = 1
	tr.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(110, 215, 255))
	tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 1) })
	tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	tr.Parent = part
	task.spawn(function()
		local t0 = os.clock()
		while alive and part.Parent do
			local a = (os.clock() - t0) / dur
			if a >= 1 then break end
			local ang = th + dir * (os.clock() - t0) * 16
			part.CFrame = CFrame.new(top + Vector3.new(math.cos(ang) * r, -H * (a ^ 1.2), math.sin(ang) * r))
			RunService.Heartbeat:Wait()
		end
		Debris:AddItem(part, 0.6)
	end)
end

-- crown of mesh ice spikes bursting out around the impact point, with ground cracks
local function iceCrown(pos)
	local ca = anchorAt(pos + Vector3.new(0, 0.4, 0), 4)
	burstEmit(EM.Crack, ca, 2.4, 1)
	burstEmit(EM.Crack, ca, 4.2, 1)
	iceSpike(pos, 4.2)
	for i = 1, 4 do
		local a = (i / 4) * math.pi * 2
		iceSpike(pos + Vector3.new(math.cos(a) * 5, 0, math.sin(a) * 5), 2.4)
	end
	local rings = { { 10, 7, 2.0 }, { 19, 10, 1.6 }, { 28, 12, 1.3 } }
	for ri, def in ipairs(rings) do
		task.delay((ri - 1) * 0.08, function()
			if not alive then return end
			for i = 1, def[2] do
				local a = (i / def[2]) * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
				iceSpike(pos + Vector3.new(math.cos(a) * def[1], 0, math.sin(a) * def[1]), def[3])
			end
		end)
	end
end

local function bloomPulse(dur, peak, rise)
	local b = Instance.new("BloomEffect")
	b.Intensity = 0
	b.Size = 40
	b.Threshold = 0.85
	b.Parent = Lighting
	tween(b, 0.08, { Intensity = peak or 1.6 })
	task.delay(0.1, function()
		if b.Parent then tween(b, dur, { Intensity = 0 }) end
	end)
	Debris:AddItem(b, dur + 0.5)
end

local function fovPunch(delta, dur)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local base = cam.FieldOfView
	tween(cam, 0.08, { FieldOfView = base + delta })
	task.delay(0.1, function()
		if cam.Parent then tween(cam, dur, { FieldOfView = base }) end
	end)
end

local casting, last, poseStop = false, 0, nil

local function runCast(char, hum, root, arms)
	-- aim is locked where you click; the beam falls from the sky onto that spot
	local mouse = lp:GetMouse()
	mouse.TargetFilter = char
	local target = mouse.Hit.Position
	local off = target - root.Position
	if off.Magnitude > CFG.maxRange then target = root.Position + off.Unit * CFG.maxRange end
	target = groundPoint(target, char)
	if (target - root.Position).Magnitude < 12 then
		target = groundPoint(root.Position + root.CFrame.LookVector * 40, char)
	end
	local skyPos = target + Vector3.new(0, PRAY.skyH, 0)

	local dim = dimWorld()
	titleCard()
	screenSnow(CFG.prayTime + PRAY.hold + 1.6, 18)
	flakeRain(target, 20, CFG.prayTime, target.Y, 1)

	local orig = { arms.r.C0, arms.l.C0 }
	local st = { a = 0, from = 0, to = 0, t0 = os.clock(), dur = 1, orb = 0, mid = root.Position }
	function st.go(to, dur)
		st.from, st.to, st.t0, st.dur = st.a, to, os.clock(), dur
	end

	local attR, snowR, mistR = handFX(char, arms.r, 1)
	local attL, snowL, mistL = handFX(char, arms.l, -1)

	local orbPart = fxPart({
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(200, 240, 255),
		Transparency = 1,
		Size = Vector3.new(0.05, 0.05, 0.05),
		CFrame = root.CFrame,
	})
	local orbLight = Instance.new("PointLight")
	orbLight.Color = Color3.fromRGB(170, 230, 255)
	orbLight.Range = 16
	orbLight.Brightness = 0
	orbLight.Parent = orbPart

	local skyOrb = fxPart({
		Shape = Enum.PartType.Ball,
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(190, 235, 255),
		Transparency = 0.25,
		Size = Vector3.new(0.5, 0.5, 0.5),
		CFrame = CFrame.new(skyPos),
	})
	local skyLight = Instance.new("PointLight")
	skyLight.Color = Color3.fromRGB(170, 230, 255)
	skyLight.Range = 60
	skyLight.Brightness = 3
	skyLight.Parent = skyOrb
	local skySparks = Instance.new("ParticleEmitter")
	skySparks.Texture = "rbxasset://textures/particles/sparkles_main.dng"
	skySparks.Rate = 60
	skySparks.Lifetime = NumberRange.new(0.6, 1.1)
	skySparks.Speed = NumberRange.new(4, 12)
	skySparks.SpreadAngle = Vector2.new(180, 180)
	skySparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	skySparks.LightEmission = 1
	skySparks.Color = ColorSequence.new(Color3.new(1, 1, 1), ICE)
	skySparks.Parent = skyOrb
	local skyAuras = {
		buildEmitter(EM.Aura1, skyOrb, CFG.emitterScale),
		buildEmitter(EM.Aura2, skyOrb, CFG.emitterScale),
	}
	local auraOn = false

	local bindName = "SnowgravePose" .. tostring(os.clock())
	RunService:BindToRenderStep(bindName, Enum.RenderPriority.Last.Value, function()
		local k = math.clamp((os.clock() - st.t0) / st.dur, 0, 1)
		k = k * k * (3 - 2 * k)
		st.a = st.from + (st.to - st.from) * k
		arms.r.C0 = armCF(orig[1], st.a, 1)
		arms.l.C0 = armCF(orig[2], st.a, -1)
		arms.r.Transform = CFrame.new()
		arms.l.Transform = CFrame.new()
		st.mid = (tipPos(char, arms.r, 1) + tipPos(char, arms.l, -1)) / 2 + Vector3.new(0, 0.3, 0)
		orbPart.CFrame = CFrame.new(st.mid)
		local s = math.max(st.orb, 0.05)
		orbPart.Size = Vector3.new(s, s, s)
		orbLight.Brightness = 0
	end)

	local made = {}
	local done = false
	local function finish()
		if done then return end
		done = true
		pcall(function() RunService:UnbindFromRenderStep(bindName) end)
		pcall(function()
			arms.r.C0, arms.l.C0 = orig[1], orig[2]
			arms.r.Transform, arms.l.Transform = CFrame.new(), CFrame.new()
		end)
		for _, e in ipairs({ snowR, snowL, mistR, mistL, skySparks, skyAuras[1], skyAuras[2] }) do pcall(function() e.Enabled = false end) end
		Debris:AddItem(attR, 2.5)
		Debris:AddItem(attL, 2.5)
		pcall(function() orbPart:Destroy() end)
		undimWorld(dim)
		Debris:AddItem(skyOrb, 1.5)
		for _, o in ipairs(made) do Debris:AddItem(o, 3) end
	end
	poseStop = finish

	local function fireBeam()
		local H = PRAY.skyH
		local S = CFG.emitterScale
		local up90 = CFrame.Angles(0, 0, math.rad(90))
		local axisX, axisZ = target.X, target.Z

		-- layered glow shells: dark blue edge -> white core (gradient, not one flat tube)
		local shellDefs = {
			{ d = 26, t = 0.9, c = Color3.fromRGB(70, 200, 255) },
			{ d = 18, t = 0.75, c = Color3.fromRGB(120, 225, 255) },
			{ d = 12, t = 0.5, c = Color3.fromRGB(180, 242, 255) },
			{ d = 6.5, t = 0.12, c = Color3.fromRGB(225, 252, 255) },
			{ d = 3, t = 0, c = Color3.new(1, 1, 1) },
		}
		local shells = {}
		for i, def in ipairs(shellDefs) do
			shells[i] = fxPart({
				Shape = Enum.PartType.Cylinder,
				Material = Enum.Material.Neon,
				Color = def.c,
				Transparency = def.t,
				Size = Vector3.new(0.1, 0.1, 0.1),
				CFrame = CFrame.new(skyPos) * up90,
			})
			made[#made + 1] = shells[i]
		end
		local vol = fxPart({ Transparency = 1, Size = Vector3.new(42 * CFG.beamScale, 0.1, 42 * CFG.beamScale), CFrame = CFrame.new(skyPos) })
		local src = fxPart({ Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(skyPos) })
		local head = fxPart({ Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(skyPos) })
		local ground = fxPart({ Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(target + Vector3.new(0, 1, 0)) })
		for _, o in ipairs({ vol, src, head, ground }) do made[#made + 1] = o end

		-- logged emitters 1-5 on the beam (scaled up)
		local aura1 = buildEmitter(EM.Aura1, vol, S)
		local aura2 = buildEmitter(EM.Aura2, vol, S)
		local flash = buildEmitter(EM.Flash, src, S * 1.3)
		local flash2 = buildEmitter(EM.Flash2, src, S * 1.3)
		local dust = buildEmitter(EM.Dust, head, S * 0.8)
		startEmitter(aura1, EM.Aura1)
		startEmitter(aura2, EM.Aura2)
		startEmitter(flash, EM.Flash)
		startEmitter(flash2, EM.Flash2)
		startEmitter(dust, EM.Dust)

		local function bigEmitter(props)
			local e = Instance.new("ParticleEmitter")
			e.Shape = Enum.ParticleEmitterShape.Box
			e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
			for k, v in pairs(props) do e[k] = v end
			e.Parent = vol
			return e
		end
		local sparks = bigEmitter({
			Texture = "rbxasset://textures/particles/sparkles_main.dng", Rate = 140,
			Lifetime = NumberRange.new(0.5, 1.2), Speed = NumberRange.new(8, 30),
			SpreadAngle = Vector2.new(180, 180), LightEmission = 1,
			Size = NS(K(0, 28), K(1, 0)),
			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 232, 255)),
		})
		local flakes = bigEmitter({
			Texture = "rbxassetid://68072538", Rate = 90,
			Lifetime = NumberRange.new(1, 2), Speed = NumberRange.new(14, 34),
			SpreadAngle = Vector2.new(180, 180), Drag = 2, Acceleration = Vector3.new(0, -20, 0),
			LightEmission = 0.6, Size = NS(K(0, 22), K(1, 4)),
			Color = ColorSequence.new(Color3.new(1, 1, 1)),
		})
		local fog = bigEmitter({
			Texture = "rbxasset://textures/particles/smoke_main.dng", Rate = 16,
			Lifetime = NumberRange.new(1, 1.8), Speed = NumberRange.new(3, 9),
			SpreadAngle = Vector2.new(180, 180), Size = NS(K(0, 90), K(1, 180)),
			Transparency = NS(K(0, 0.6), K(1, 1)), Color = ColorSequence.new(Color3.fromRGB(200, 235, 255)),
		})

		local dupes = {}

		local widthMul = 0
		local function setBeam(alpha, pulse)
			local len = math.max(H * alpha, 0.1)
			local c = skyPos - Vector3.new(0, len / 2, 0)
			for i, def in ipairs(shellDefs) do
				local d = math.max(def.d * CFG.beamScale * widthMul * (1 + pulse * (i <= 2 and 0.1 or 0.05)), 0.1)
				shells[i].Size = Vector3.new(len, d, d)
				shells[i].CFrame = CFrame.new(c) * up90
			end
			vol.Size = Vector3.new(42 * CFG.beamScale * math.max(widthMul, 0.1), len, 42 * CFG.beamScale * math.max(widthMul, 0.1))
			vol.CFrame = CFrame.new(c)
			head.CFrame = CFrame.new(skyPos - Vector3.new(0, len, 0))
		end

		playSound(CFG.soundBeam, SoundService, 3)
		flakeRain(target, CFG.radius * 1.5, PRAY.hold + 1.4, target.Y, 2)
		tween(skyOrb, 0.25, { Size = Vector3.new(26 * CFG.beamScale, 26 * CFG.beamScale, 26 * CFG.beamScale), Transparency = 0.6 })
		bloomPulse(0.25, 2.2, 1.6)

		-- the beam slams down from the sky, width pops open as it falls
		local t0 = os.clock()
		local nextDust, nextStreak = 0, 0
		while alive do
			local raw = math.clamp((os.clock() - t0) / 0.36, 0, 1)
			widthMul = math.min(1, raw * 3)
			setBeam(raw * raw, 0)
			local now = os.clock()
			if now >= nextDust then
				nextDust = now + 0.06
				pcall(function() dust:Emit(4) end)
			end
			if now >= nextStreak then
				nextStreak = now + 0.14
				spiralStreak(skyPos, H, 0.4)
			end
			if raw >= 1 then break end
			task.wait()
		end

		-- impact: logged emitters 6 and 7 on the ground (scaled up)
		local hit = buildEmitter(EM.Hit, ground, S * 0.3)
		local hitBase = buildEmitter(EM.HitBase, ground, S * 0.3)
		startEmitter(hit, EM.Hit)
		startEmitter(hitBase, EM.HitBase)
		local star = buildEmitter(EM.Star12, ground, S * 1.1)
		startEmitter(star, EM.Star12)
		task.delay(3.2, function()
			pcall(function() star.Enabled = false end)
		end)
		pcall(function() dust:Emit(40) end)

		local burst = fxPart({
			Shape = Enum.PartType.Ball,
			Material = Enum.Material.Neon,
			Color = Color3.new(1, 1, 1),
			Transparency = 0.1,
			Size = Vector3.new(6, 6, 6),
			CFrame = CFrame.new(target),
		})
		tween(burst, 0.8, { Size = Vector3.new(CFG.radius * 2, CFG.radius * 2, CFG.radius * 2), Transparency = 1 })
		Debris:AddItem(burst, 0.9)

		local base = target + Vector3.new(0, 0.6, 0)
		particleRing(base, 22, 130, 34)
		task.delay(0.12, function() if alive then particleRing(base, 16, 90, 28) end end)
		task.delay(0.26, function() if alive then particleRing(base, 12, 55, 22) end end)
		iceDebris(target, 16)
		iceCrown(target)

		bloomPulse(0.9, 1.8, 2)
		flakeBurst(target + Vector3.new(0, 3, 0), 26)
		pcall(function()
			tween(dim, 0.06, { Brightness = 0.7 })
			task.delay(0.09, function() tween(dim, 0.5, { Brightness = -0.22 }) end)
		end)
		fovPunch(14, 0.7)
		screenFlash(0.7)
		skyTint()
		groundRing(target)
		blizzard(target)
		shards(target)
		shakeCamera(1.6, PRAY.hold + 0.5)
		hitNPCs(target)
		hitLoose(target)
		st.go(0, PRAY.lower)
		tween(orbPart, 0.5, { Size = Vector3.new(0.05, 0.05, 0.05) })

		-- hold: pulsing column, spiral ribbons, descending wind rings
		local h0 = os.clock()
		local nextWave = 0
		while alive and os.clock() - h0 < PRAY.hold do
			local now = os.clock()
			local pulse = (math.floor((now - h0) * 14) % 2 == 0) and 1 or -1
			setBeam(1, pulse)
			if now >= nextStreak then
				nextStreak = now + 0.14
				spiralStreak(skyPos, H, 0.45)
			end
			if now >= nextWave then
				nextWave = now + 0.55
				for i = 0, 2 do
					task.delay(i * 0.05, function()
						if alive then
							particleRing(Vector3.new(axisX, target.Y + H * (0.9 - i * 0.28), axisZ), 8, 70, 26)
						end
					end)
				end
			end
			task.wait()
		end

		-- emitters stay on a little longer than the beam body
		task.delay(0.9, function()
			for _, e in ipairs({ aura1, aura2, flash, flash2, sparks, flakes, fog }) do pcall(function() e.Enabled = false end) end
			for _, e in ipairs(dupes) do pcall(function() e.Enabled = false end) end
		end)
		local f0 = os.clock()
		while alive and os.clock() - f0 < 0.5 do
			local k = (os.clock() - f0) / 0.5
			widthMul = 1 - k
			setBeam(1, 0)
			for i, def in ipairs(shellDefs) do
				shells[i].Transparency = def.t + (1 - def.t) * k
			end
			task.wait()
		end
		tween(skyOrb, 0.4, { Size = Vector3.new(0.5, 0.5, 0.5), Transparency = 1 })
	end

	local ok, err = pcall(function()
		st.go(1, PRAY.raise)
		local s = playSound(CFG.soundPray, root, 2.5, true)
		local t0 = os.clock()
		local nextR, nextL = 0, 0.05
		while alive and hum.Health > 0 do
			local t = os.clock() - t0
			local total = CFG.prayTime
			if t >= total then break end
			local p = math.clamp(t / total, 0, 1)
			if s then
				pcall(function() s.Volume = 2.5 * math.clamp((total - t) / 0.6, 0, 1) end)
			end

			local rate = 10 + 80 * p
			snowR.Rate, snowL.Rate = rate, rate
			mistR.Rate, mistL.Rate = 4 + 10 * p, 4 + 10 * p
			st.orb = p * 2
			skyOrb.Size = Vector3.new(0.5 + p * 8, 0.5 + p * 8, 0.5 + p * 8)

			if t > 0.35 then
				if not auraOn then
					auraOn = true
					startEmitter(skyAuras[1], EM.Aura1)
					startEmitter(skyAuras[2], EM.Aura2)
				end
				local now = os.clock()
				local interval = 0.3 - 0.14 * p
				local jitter = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))
				if now >= nextR then
					nextR = now + interval
					flyOrb(tipPos(char, arms.r, 1), skyPos + jitter, 1 + rng:NextNumber(0, 0.4))
				end
				if now >= nextL then
					nextL = now + interval
					flyOrb(tipPos(char, arms.l, -1), skyPos - jitter, 1 + rng:NextNumber(0, 0.4))
				end
			end
			task.wait()
		end
		snowR.Rate, snowL.Rate, mistR.Rate, mistL.Rate = 0, 0, 0, 0
		if s then pcall(function() s:Stop() end) end
		if not alive or hum.Health <= 0 then return end

		-- first audio is done: the beam goes
		fireBeam()
		task.wait(PRAY.lower)
	end)
	finish()
	poseStop = nil
	if not ok then report("cast error", err) end
end

local function cast(tool)
	if casting or os.clock() - last < CFG.cooldown then return end
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end
	local arms = getArms(char) or fakeArms(char, root)
	casting = true
	task.spawn(function()
		local ok, err = pcall(runCast, char, hum, root, arms)
		if not ok then
			report("cast error", err)
			if poseStop then pcall(poseStop) poseStop = nil end
		end
		casting = false
		last = os.clock()
	end)
end

