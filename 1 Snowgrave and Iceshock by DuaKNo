env.__SnowgraveStop = function()
	alive = false
	if poseStop then pcall(poseStop) end
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	for _, holder in ipairs({ lp:FindFirstChildOfClass("Backpack"), lp.Character }) do
		if holder then
			for _, d in ipairs(holder:GetChildren()) do
				if d:IsA("Tool") and d:GetAttribute("SnowgraveTool") then pcall(function() d:Destroy() end) end
			end
		end
	end
	pcall(function() fxFolder:Destroy() end)
	pcall(function() template:Destroy() end)
	pcall(function() iceTemplate:Destroy() end)
	env.__SnowgraveStop = nil
end
