			if not tpl or not main.Parent then return end
			local def = SPIKE_DEFS[idx]
			local ang = (i / n) * math.pi * 2 + rng:NextNumber(-0.25, 0.25)
			local out = Vector3.new(math.cos(ang), 0, -math.sin(ang))
			local h = math.clamp(bsz.Y * rng:NextNumber(0.5, 0.95), 2.5, 16)
			local sc = h / def.size.Y
			local base = CFrame.new(Vector3.new(ctr.X, gy, ctr.Z) + out * rad)
				* CFrame.Angles(0, ang, 0)
				* CFrame.Angles(0, 0, -math.rad(rng:NextNumber(14, 34)))
			local startCF = base * CFrame.new(0, -h * 0.55, 0) * SPIKE_ROT
			local endCF = base * CFrame.new(0, h / 2 - h * 0.06, 0) * SPIKE_ROT
			local sp = spikePart(tpl, def, sc, startCF, false)
			add(sp)
			tween(sp, 0.3, { CFrame = endCF }, Enum.EasingStyle.Back)
			if not lite and i % 2 == 0 then
				local halo = spikePart(tpl, def, sc, startCF, true)
				add(halo)
				tween(halo, 0.3, { CFrame = endCF }, Enum.EasingStyle.Back)
			end
			task.wait(0.03)
		end
	end)
	-- a few crystals poking out of the top
	if not lite then
		task.spawn(function()
			for i = 1, 3 do
				local idx = rng:NextInteger(1, #SPIKE_DEFS)
				local tpl = getSpikeTemplate(idx)
				if not tpl or not main.Parent or not alive then return end
				local def = SPIKE_DEFS[idx]
				local h = math.clamp(bsz.Y * 0.35, 2, 8)
				local sc = h / def.size.Y
				local top = bcf.Position + Vector3.new(rng:NextNumber(-1, 1) * bsz.X * 0.3, bsz.Y / 2, rng:NextNumber(-1, 1) * bsz.Z * 0.3)
				local base = CFrame.new(top) * CFrame.Angles(math.rad(rng:NextNumber(-25, 25)), rng:NextNumber(0, 6.28), math.rad(rng:NextNumber(-25, 25)))
				local sp = spikePart(tpl, def, sc, base * CFrame.new(0, -h * 0.5, 0) * SPIKE_ROT, false)
				add(sp)
				tween(sp, 0.3, { CFrame = base * CFrame.new(0, h / 2 - 0.3, 0) * SPIKE_ROT }, Enum.EasingStyle.Back)
				task.wait(0.05)
			end
		end)
	end
	pcall(flakeBurst, bcf.Position, lite and 3 or 10)
	return function(shatter)
		if shatter then
			pcall(iceDebris, bcf.Position, lite and 6 or 14)
		end
		for _, o in ipairs(made) do
			if o and o.Parent then
				pcall(function() tween(o, 0.18, { Transparency = 1 }) end)
				Debris:AddItem(o, 0.3)
			end
		end
	end
end

local function freezeNPC(model, from, dur, boom)
	if frozen[model] then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	if not hum or not root or hum.Health <= 0 then return end
	frozen[model] = true
	simBoost()
	pcall(function()
		hum.WalkSpeed = 0
		hum.JumpHeight = 0
		hum.JumpPower = 0
		hum.AutoRotate = false
	end)
	-- knockback: thrown away from the impact, then frozen where they land
	from = from or root.Position
	local dir = Vector3.new(root.Position.X - from.X, 0, root.Position.Z - from.Z)
	if dir.Magnitude > 0.1 then
		dir = dir.Unit
	else
		dir = Vector3.new(rng:NextNumber(-1, 1), 0, rng:NextNumber(-1, 1)).Unit
	end
	pcall(function()
		root.AssemblyLinearVelocity = dir * 60 + Vector3.new(0, 40, 0)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
	end)
	task.wait(0.4)
	if not alive or not root.Parent then
		frozen[model] = nil
		return
	end
	local cf = root.CFrame
	local block
	pcall(function()
		local bcf, bsz = model:GetBoundingBox()
		block = iceCage(bcf, bsz, false)
	end)
	local trackT = 0
	local hold = RunService.Heartbeat:Connect(function(dt)
		if not root.Parent then return end
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		root.CFrame = cf
		trackT += dt
		if trackT >= 0.25 then
			trackT = 0
			pcall(function()
				for _, t in ipairs(hum:GetPlayingAnimationTracks()) do t:AdjustSpeed(0) end
			end)
		end
	end)
	task.delay(dur or CFG.freezeTime, function()
		hold:Disconnect()
		if block then pcall(block, true) end
		frozen[model] = nil
		if not root.Parent then return end
		if boom and explodeFX then pcall(explodeFX, root.Position) end
		shatterBurst(root.CFrame)
		flakeBurst(root.Position, 8)
		if CFG.killNPCs then
			simBoost()
			pcall(function() hum.Health = 0 end)
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
			pcall(function() model:BreakJoints() end)
			pcall(function()
				for _, d in ipairs(model:GetDescendants()) do
					if d:IsA("BasePart") then
						d.AssemblyLinearVelocity = dir * 50 + Vector3.new(0, 34, 0)
					end
				end
			end)
		else
			pcall(function()
				hum.WalkSpeed = 16
				hum.JumpHeight = 7.2
				hum.AutoRotate = true
			end)
		end
	end)
end

