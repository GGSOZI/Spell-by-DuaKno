-- the Iceshock spell: an ice ball wrapped in snowflakes flies to where you clicked
local function iceBall(char, arms, target)
	local root = char:FindFirstChild("HumanoidRootPart")
	local from = arms and tipPos(char, arms.r, 1) or (root.Position + Vector3.new(0, 2, 0))
	local to = target + Vector3.new(0, 3, 0)
	local dist = (to - from).Magnitude
	local dur = math.clamp(dist / 110, 0.4, 1.4)

	-- lightning-style path: random zig-zag waypoints that always end exactly on the target
	local N = math.clamp(math.floor(dist / 7), 8, 22)
	local amp = math.clamp(dist * 0.07, 2.5, 8)
	local dir = dist > 0.01 and (to - from) / dist or Vector3.zAxis
	local side = dir:Cross(Vector3.yAxis)
	side = side.Magnitude > 0.1 and side.Unit or Vector3.xAxis
	local up = side:Cross(dir).Unit
	local way = { from }
	for i = 1, N - 1 do
		local f = i / N
		local taper = math.sin(f * math.pi) ^ 0.6
		local off = (side * rng:NextNumber(-1, 1) + up * rng:NextNumber(-1, 1)) * amp * taper
		way[#way + 1] = from:Lerp(to, f) + off
	end
	way[#way + 1] = to

	local ball = fxPart({
		Shape = Enum.PartType.Ball, Material = Enum.Material.Neon, Color = Color3.fromRGB(205, 245, 255),
		Transparency = 0.1, Size = Vector3.new(0.3, 0.3, 0.3), CFrame = CFrame.new(from),
	})
	local shell = fxPart({
		Shape = Enum.PartType.Ball, Material = Enum.Material.Ice, Color = ICE,
		Transparency = 0.5, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(from),
	})
	tween(ball, 0.2, { Size = Vector3.new(1.1, 1.1, 1.1) }, Enum.EasingStyle.Back)
	tween(shell, 0.2, { Size = Vector3.new(1.8, 1.8, 1.8) }, Enum.EasingStyle.Back)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 230, 255)
	light.Range = 14
	light.Brightness = 2
	light.Parent = ball

	local a0 = Instance.new("Attachment")
	a0.Position = Vector3.new(0, 0.6, 0)
	a0.Parent = ball
	local a1 = Instance.new("Attachment")
	a1.Position = Vector3.new(0, -0.6, 0)
	a1.Parent = ball
	local tr = Instance.new("Trail")
	tr.Attachment0, tr.Attachment1 = a0, a1
	tr.Lifetime = 0.35
	tr.FaceCamera = true
	tr.LightEmission = 1
	tr.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(110, 215, 255))
	tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	tr.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
	tr.Parent = ball

	local spark = Instance.new("ParticleEmitter")
	spark.Texture = "rbxasset://textures/particles/sparkles_main.dng"
	spark.Rate = 22
	spark.Lifetime = NumberRange.new(0.5, 0.9)
	spark.Speed = NumberRange.new(1, 4)
	spark.SpreadAngle = Vector2.new(180, 180)
	spark.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	spark.LightEmission = 1
	spark.Color = ColorSequence.new(Color3.new(1, 1, 1), ICE)
	spark.Parent = ball
	local snow = snowEmitter(ball, 14)
	snow.Lifetime = NumberRange.new(0.8, 1.4)
	snow.Speed = NumberRange.new(2, 6)
	snow.SpreadAngle = Vector2.new(180, 180)
	snow.Acceleration = Vector3.new(0, 0, 0)
	snow.EmissionDirection = Enum.NormalId.Top
	snow.Size = NumberSequence.new(0.7, 0.2)

	-- pixel snowflakes orbiting the ball
	local orbit = {}
	for i = 1, 4 do
		local fp = fxPart({ Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2), CFrame = CFrame.new(from) })
		local holder = buildFlakeGui(fp, rng:NextNumber(0.9, 1.3))
		orbit[i] = { part = fp, holder = holder, ph = (i / 4) * math.pi * 2, spin = rng:NextNumber(-300, 300) }
	end

	local t0 = os.clock()
	local pos = from
	while alive do
		local el = os.clock() - t0
		local a = math.clamp(el / dur, 0, 1)
		local seg = a * N
		local si = math.min(math.floor(seg), N - 1)
		pos = way[si + 1]:Lerp(way[si + 2], seg - si)
		if a < 1 then pos += Vector3.new(rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3), rng:NextNumber(-0.3, 0.3)) end
		ball.CFrame = CFrame.new(pos)
		shell.CFrame = CFrame.new(pos) * CFrame.Angles(el * 3, el * 2, 0)
		for _, o in ipairs(orbit) do
			local ang = o.ph + el * 8
			o.part.CFrame = CFrame.new(pos + Vector3.new(math.cos(ang) * 1.6, math.sin(el * 5 + o.ph) * 0.5, math.sin(ang) * 1.6))
			o.holder.Rotation = el * o.spin
		end
		if a >= 1 then break end
		RunService.Heartbeat:Wait()
	end

	tr.Enabled = false
	spark.Enabled = false
	snow.Enabled = false
	for _, o in ipairs(orbit) do pcall(function() o.part:Destroy() end) end
	pcall(function()
		tween(ball, 0.3, { Transparency = 1 })
		tween(shell, 0.3, { Transparency = 1 })
		tween(light, 0.3, { Brightness = 0 })
	end)
	Debris:AddItem(ball, 0.8)
	Debris:AddItem(shell, 0.8)
	return pos
end

local iceBusy, iceLast = false, 0

local function castIce(tool)
	if iceBusy or os.clock() - iceLast < 1.4 then return end
	local char = lp.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then return end
	iceBusy = true
	task.spawn(function()
		local arms = getArms(char)
		local orig = arms and arms.r.C0
		local bind = "IceshockPose" .. tostring(os.clock())
		local ok, err = pcall(function()
			local mouse = lp:GetMouse()
			mouse.TargetFilter = char
			local target = mouse.Hit.Position
			local off = target - root.Position
			if off.Magnitude > CFG.maxRange then target = root.Position + off.Unit * CFG.maxRange end
			target = groundPoint(target, char)

			-- lock on to the nearest NPC around the aim point
			local params = OverlapParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { char, fxFolder }
			local best, bd = nil, 18
			for _, part in ipairs(workspace:GetPartBoundsInRadius(target, 18, params)) do
				local m = part:FindFirstAncestorOfClass("Model")
				local r = m and m:FindFirstChild("HumanoidRootPart")
				if r and m:FindFirstChildOfClass("Humanoid") and not Players:GetPlayerFromCharacter(m) then
					local d = (r.Position - target).Magnitude
					if d < bd then best, bd = r, d end
				end
			end
			if best then target = groundPoint(best.Position, char) end

			if arms then
				local t0 = os.clock()
				RunService:BindToRenderStep(bind, Enum.RenderPriority.Last.Value, function()
					local k = math.clamp((os.clock() - t0) / 0.9, 0, 1)
					arms.r.C0 = armCF(orig, math.sin(k * math.pi) * 0.85, 1)
					arms.r.Transform = CFrame.new()
				end)
				flakeBurst(tipPos(char, arms.r, 1), 6)
			end
			task.wait(0.3)
			if not alive or hum.Health <= 0 then return end

			iceBall(char, arms, target) -- the ball flies to the click spot first
			if not alive then return end
			playSound(CFG.soundIce, SoundService, 2.5)
			iceShockFX(target)
			hitNPCs(target, 14, 3.5, true)
			task.wait(0.55)
		end)
		pcall(function() RunService:UnbindFromRenderStep(bind) end)
		if arms then
			pcall(function()
				arms.r.C0 = orig
				arms.r.Transform = CFrame.new()
			end)
		end
		if not ok then report("iceshock error", err) end
		iceBusy = false
		iceLast = os.clock()
	end)
end

local function giveTool(tpl, handler)
	if not alive then return end
	local backpack = lp:FindFirstChildOfClass("Backpack") or lp:WaitForChild("Backpack", 10)
	if not backpack then return end
	local char = lp.Character
	if backpack:FindFirstChild(tpl.Name) or (char and char:FindFirstChild(tpl.Name)) then return end
	local t = tpl:Clone()
	t.Activated:Connect(function() handler(t) end)
	t.Parent = backpack
end

local function give()
	giveTool(template, cast)
	giveTool(iceTemplate, castIce)
end

