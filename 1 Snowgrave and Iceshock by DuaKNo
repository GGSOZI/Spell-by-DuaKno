end

local function groundRing(pos)
	local ring = fxPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Material = Enum.Material.Neon,
		Color = ICE,
		Transparency = 0.25,
	})
	tween(ring, 0.7, { Size = Vector3.new(0.4, CFG.radius * 2, CFG.radius * 2), Transparency = 1 })
	Debris:AddItem(ring, 1)

	local flash = fxPart({ Transparency = 1, Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(pos + Vector3.new(0, 6, 0)) })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(170, 225, 255)
	light.Range = 60
	light.Brightness = 8
	light.Parent = flash
	tween(light, 1.6, { Brightness = 0 })
	Debris:AddItem(flash, 2)
end

