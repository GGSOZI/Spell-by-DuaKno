local function scaleSeq(seq, s)
	local pts = {}
	for _, k in ipairs(seq.Keypoints) do
		pts[#pts + 1] = NumberSequenceKeypoint.new(k.Time, k.Value * s, k.Envelope * s)
	end
	return NumberSequence.new(pts)
end

local function buildEmitter(spec, parent, scale)
	local fx = Instance.new("ParticleEmitter")
	fx.Name = spec.name
	fx.Enabled = false
	for k, v in pairs(COMMON) do pcall(function() fx[k] = v end) end
	for k, v in pairs(spec.props) do pcall(function() fx[k] = v end) end
	scale = scale or 1
	if scale ~= 1 then
		pcall(function() fx.Size = scaleSeq(fx.Size, scale) end)
	end
	pcall(function() fx.Rate = fx.Rate * CFG.rateMult end)
	fx.Parent = parent
	return fx
end

local function startEmitter(fx, spec)
	if spec.enabled then
		fx.Enabled = true
	else
		fx.Enabled = false
		pcall(function() fx:Emit(math.max(1, math.floor(spec.emit * CFG.emitMult + 0.5))) end)
	end
end

