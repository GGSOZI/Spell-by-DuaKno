local function armCF(orig, a, side)
	local base = orig.Rotation
	local q = CFrame.Angles(0, math.rad(PRAY.yaw) * a * side, 0) * CFrame.Angles(math.rad(PRAY.lift) * a, 0, 0)
	return orig * (base:Inverse() * q * base)
end

