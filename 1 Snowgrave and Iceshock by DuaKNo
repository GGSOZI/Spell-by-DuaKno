local spikeTpl, spikeBusy = {}, {}
local function getSpikeTemplate(i)
	if spikeTpl[i] then return spikeTpl[i] end
	if spikeBusy[i] then
		local t0 = os.clock()
		while spikeBusy[i] and not spikeTpl[i] and os.clock() - t0 < 6 do task.wait() end
		return spikeTpl[i]
	end
	spikeBusy[i] = true
	local url = "rbxassetid://" .. SPIKE_DEFS[i].id
	local mp
	pcall(function()
		local m = Instance.new("MeshPart")
		m.MeshId = url
		if m.MeshId ~= "" then mp = m else m:Destroy() end
	end)
	if not mp then
		pcall(function()
			mp = InsertService:CreateMeshPartAsync(url, Enum.CollisionFidelity.Box, Enum.RenderFidelity.Automatic)
		end)
	end
	if not mp then
		pcall(function() -- last resort: plain part + file mesh
			local part = Instance.new("Part")
			local sm = Instance.new("SpecialMesh")
			sm.MeshType = Enum.MeshType.FileMesh
			sm.MeshId = url
			sm.Parent = part
			mp = part
		end)
	end
	if mp then
		mp.Name = "IceSpike"
		mp.Anchored = true
		mp.CanCollide = false
		mp.CanQuery = false
		mp.CanTouch = false
		mp.CastShadow = false
		mp.Massless = true
		mp.Material = Enum.Material.Glass
		mp.Color = SPIKE_COLOR
		mp.Transparency = 0.1
		mp.Reflectance = 0
		pcall(function() mp.CollisionFidelity = Enum.CollisionFidelity.Box end)
		pcall(function() mp.TextureID = "" end)
		pcall(function() game:GetService("ContentProvider"):PreloadAsync({ mp }) end) -- load the mesh once, not on first cast
		spikeTpl[i] = mp
	end
	spikeBusy[i] = nil
	return mp
end

-- preload meshes + every particle texture at startup so the first cast does not hitch
task.spawn(function()
	local list = {}
	for i = 1, #SPIKE_DEFS do
		local t = getSpikeTemplate(i)
		if t then list[#list + 1] = t end
	end
	local temp = {}
	for _, spec in pairs(EM) do
		local ok, e = pcall(buildEmitter, spec, nil, 1)
		if ok and e then
			list[#list + 1] = e
			temp[#temp + 1] = e
		end
	end
	pcall(function() game:GetService("ContentProvider"):PreloadAsync(list) end)
	for _, e in ipairs(temp) do pcall(function() e:Destroy() end) end
end)

local function spikePart(tpl, def, sc, cf, halo)
	local m = halo and 1.15 or 1
	local sp = tpl:Clone()
	sp.Size = def.size * sc * m
	local sm = sp:FindFirstChildOfClass("SpecialMesh")
	if sm then sm.Scale = Vector3.new(sc * m, sc * m, sc * m) end
	if halo then -- soft glowing frost shell around the glass
		sp.Material = Enum.Material.Neon
		sp.Color = Color3.fromRGB(150, 225, 255)
		sp.Transparency = 0.78
	end
	sp.CFrame = cf
	sp.Parent = fxFolder
	return sp
end

-- sat = true: a small satellite spike growing next to a big one
local function iceSpike(pos, mult, sat)
	mult = mult or 1
	local idx = rng:NextInteger(1, #SPIKE_DEFS)
	local tpl = getSpikeTemplate(idx)
	if not tpl or not alive then return end
	local def = SPIKE_DEFS[idx]
	local h = rng:NextNumber(6, 10) * mult
	local sc = h / def.size.Y
	local lean = sat and 28 or 12
	local base = CFrame.new(pos)
		* CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		* CFrame.Angles(math.rad(rng:NextNumber(-lean, lean)), 0, math.rad(rng:NextNumber(-lean, lean)))
	local sink = h * 0.06
	local startCF = base * CFrame.new(0, -h * 0.55, 0) * SPIKE_ROT
	local endCF = base * CFrame.new(0, h / 2 - sink, 0) * SPIKE_ROT

	local spike = spikePart(tpl, def, sc, startCF, false)
	local parts = { spike }
	if mult >= 1.5 and not sat then parts[2] = spikePart(tpl, def, sc, startCF, true) end
	local delay = sat and rng:NextNumber(0.05, 0.22) or 0
	for _, p in ipairs(parts) do
		task.delay(delay, function()
			if p.Parent then tween(p, 0.32, { CFrame = endCF }, Enum.EasingStyle.Back) end
		end)
	end

	if not sat then
		-- ground burst where the spike breaks out
		local ba = anchorAt(pos + Vector3.new(0, 0.4, 0), 2.5)
		burstEmit(EM.IceDebris, ba, 1.2 + mult * 0.8, 8 + math.floor(mult * 3))
		burstEmit(EM.Crack, ba, 0.5 + mult * 0.5, 1)
		if mult >= 2 then
			burstEmit(EM.GlassShard, ba, 0.6 + mult * 0.3, 3)
			-- expanding frost ring on the ground
			local ring = fxPart({
				Shape = Enum.PartType.Cylinder, Material = Enum.Material.Neon, Color = ICE, Transparency = 0.3,
				Size = Vector3.new(0.3, 2, 2),
				CFrame = CFrame.new(pos + Vector3.new(0, 0.35, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			})
			tween(ring, 0.55, { Size = Vector3.new(0.3, 7 * mult, 7 * mult), Transparency = 1 })
			Debris:AddItem(ring, 0.7)
			-- twinkling sparkles on the spike while it stands
			local tw = Instance.new("ParticleEmitter")
			tw.Texture = "rbxasset://textures/particles/sparkles_main.dng"
			tw.Rate = 6
			tw.Lifetime = NumberRange.new(0.8, 1.4)
			tw.Speed = NumberRange.new(1, 5)
			tw.SpreadAngle = Vector2.new(180, 180)
			tw.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) })
			tw.LightEmission = 1
			tw.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(130, 215, 255))
			tw.Parent = spike
			-- a cluster of smaller spikes leaning out around the base
			for _ = 1, 3 do
				local a = rng:NextNumber(0, math.pi * 2)
				local r = h * rng:NextNumber(0.18, 0.3)
				iceSpike(pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r), mult * rng:NextNumber(0.3, 0.5), true)
			end
		end
		if mult >= 3 then smokePuff(pos + Vector3.new(0, 1, 0), 9 * mult, 3) end
	end

	-- shatter: glass shards / chroma glass / ice dust
	task.delay(CFG.freezeTime + rng:NextNumber(0, 0.45), function()
		if not alive or not spike.Parent then return end
		local c = spike.Position
		for _, p in ipairs(parts) do pcall(function() p:Destroy() end) end
		local k = math.clamp(mult, 0.5, 4)
		local a = anchorAt(c, 6.2)
		if sat then
			burstEmit(EM.GlassShard, a, 0.6 + k, 3)
			return
		end
		burstEmit(EM.ChromaGlass, a, 0.6 + k * 0.5, 3 + math.floor(k * 1.5))
		burstEmit(EM.GlassShard, a, 0.6 + k * 0.5, 3 + math.floor(k * 1.5))
		burstEmit(EM.IceDebris, a, 1 + k * 0.6, 8 + math.floor(k * 3))
		if mult >= 3 then smokePuff(c, 14 * mult, 4) end
	end)
end

local function shards(pos)
	local r = CFG.radius
	task.spawn(function()
		for _ = 1, 12 do
			if not alive then return end
			local a = rng:NextNumber(0, math.pi * 2)
			local d = math.sqrt(rng:NextNumber(0, 1)) * r * 0.9
			local ground = pos + Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
			local len = rng:NextNumber(3, 6)
			local s = fxPart({
				Material = Enum.Material.Neon,
				Color = Color3.fromRGB(200, 240, 255),
				Transparency = 0.1,
				Size = Vector3.new(0.7, len, 0.7),
				CFrame = CFrame.new(ground + Vector3.new(0, 70, 0)) * CFrame.Angles(math.rad(rng:NextNumber(-12, 12)), 0, math.rad(rng:NextNumber(-12, 12))),
			})
			local tw = tween(s, 0.3, { CFrame = CFrame.new(ground + Vector3.new(0, len / 2, 0)) * (s.CFrame - s.CFrame.Position) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw.Completed:Connect(function()
				if rng:NextNumber() < 0.3 then iceSpike(ground) end
				tween(s, 0.25, { Transparency = 1 })
				Debris:AddItem(s, 0.3)
			end)
			task.wait(0.06)
		end
	end)
end

