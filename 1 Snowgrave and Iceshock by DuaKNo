-- a snowflake that leaves the hand and curves up to the beam start in the sky
local function flyOrb(p0, p2, dur)
	local orb = fxPart({ Transparency = 1, Size = Vector3.new(0.3, 0.3, 0.3), CFrame = CFrame.new(p0) })
	local fsz = math.clamp((p2 - p0).Magnitude / 50, 1.5, 4) -- bigger flakes for longer flights so they read from far away
	flakeBurst(p0, 3)
	-- stream of snowflakes left behind the orb
	local flakes = snowEmitter(orb, 45)
	flakes.Lifetime = NumberRange.new(0.7, 1.2)
	flakes.Speed = NumberRange.new(0, 4)
	flakes.SpreadAngle = Vector2.new(180, 180)
	flakes.Acceleration = Vector3.new(0, 0, 0)
	flakes.EmissionDirection = Enum.NormalId.Top
	flakes.Size = NumberSequence.new(fsz, fsz * 0.3)
	flakes.LightEmission = 1
	flakes.ZOffset = 1
	-- one big flake that rides on the orb itself
	local head = snowEmitter(orb, 10)
	head.Lifetime = NumberRange.new(0.25, 0.3)
	head.Speed = NumberRange.new(0, 0)
	head.SpreadAngle = Vector2.new(0, 0)
	head.Acceleration = Vector3.new(0, 0, 0)
	head.LockedToPart = true
	head.Size = NumberSequence.new(fsz * 1.1)
	head.LightEmission = 1
	head.ZOffset = 1
	local trail = Instance.new("ParticleEmitter")
	trail.Texture = "rbxassetid://68072538"
	trail.Rate = 22
	trail.Lifetime = NumberRange.new(0.35, 0.7)
	trail.Speed = NumberRange.new(0.5, 3)
	trail.SpreadAngle = Vector2.new(180, 180)
	trail.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 0) })
	trail.LightEmission = 1
	trail.Color = ColorSequence.new(Color3.new(1, 1, 1), ICE)
	trail.Parent = orb
	local p1 = p0:Lerp(p2, 0.5) + Vector3.new(rng:NextNumber(-14, 14), 25, rng:NextNumber(-14, 14))
	task.spawn(function()
		local t0 = os.clock()
		while alive and orb.Parent do
			local el = os.clock() - t0
			local a = el / dur
			if a >= 1 then break end
			a = a ^ 1.4
			orb.CFrame = CFrame.new(p0:Lerp(p1, a):Lerp(p1:Lerp(p2, a), a))
			RunService.Heartbeat:Wait()
		end
		trail.Enabled = false
		flakes.Enabled = false
		head.Enabled = false
		Debris:AddItem(orb, 1)
	end)
end

