function U.buildEmitter(name, parent)
	local d = DEFS[name]
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Enabled = false
	local function set(prop, val)
		pcall(function() e[prop] = val end)
	end
	set("Texture", d.tex)
	set("Rate", d.rate)
	set("Lifetime", NumberRange.new(d.life[1], d.life[2]))
	set("Speed", NumberRange.new(d.speed[1], d.speed[2]))
	set("Color", ColorSequence.new(d.color))
	set("Transparency", U.NS(d.transp))
	set("Rotation", NumberRange.new(d.rot[1], d.rot[2]))
	local rs = d.rotSpeed or {0, 0}
	set("RotSpeed", NumberRange.new(rs[1], rs[2]))
	set("SpreadAngle", Vector2.new(d.spread, d.spread))
	set("Acceleration", d.accel or Vector3.zero)
	set("Drag", d.drag)
	set("EmissionDirection", d.dir)
	set("LightEmission", d.lightEm)
	set("LightInfluence", d.lightInf)
	set("LockedToPart", d.locked or false)
	set("ZOffset", d.zoff)
	set("Orientation", d.orient)
	set("Squash", U.NS(d.squash or {{0, 0}, {1, 0}}))
	set("Shape", d.shape or Enum.ParticleEmitterShape.Box)
	set("FlipbookLayout", d.flip or Enum.ParticleFlipbookLayout.None)
	set("FlipbookMode", d.flipMode or Enum.ParticleFlipbookMode.Loop)
	set("FlipbookFramerate", NumberRange.new(d.flipFps or 1, d.flipFps or 1))
	set("Brightness", d.bright)
	set("Size", U.NS(d.size, 0.3 * CONFIG.ParticleScale * (d.cs or 1)))
	e.Parent = parent
	return e
end

