function U.NS(list, scale)
	scale = scale or 1
	local kps = {}
	for _, k in ipairs(list) do
		kps[#kps + 1] = NumberSequenceKeypoint.new(k[1], k[2] * scale, (k[3] or 0) * scale)
	end
	return NumberSequence.new(kps)
end

