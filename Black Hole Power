function U.getNpc(part)
	local m = part:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then
			if Players:GetPlayerFromCharacter(m) then
				return nil, true
			end
			return m, false
		end
		m = m.Parent and m.Parent:FindFirstAncestorOfClass("Model")
	end
	return nil, false
end

function U.setFilter(folder)
	local f = {folder}
	if lp.Character then
		f[#f + 1] = lp.Character
	end
	overlap.FilterDescendantsInstances = f
end

function U.shake(power)
	local char = lp.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if power <= 0.02 then
		hum.CameraOffset = Vector3.zero
		return
	end
	task.spawn(function()
		local t = os.clock()
		while os.clock() - t < 0.7 do
			local fade = 1 - (os.clock() - t) / 0.7
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * power * fade, (math.random() - 0.5) * power * fade, 0)
			RunService.RenderStepped:Wait()
		end
		hum.CameraOffset = Vector3.zero
	end)
end

function U.pushNpc(model, hp)
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		pcall(function() hum.PlatformStand = false end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
	end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and not p.Anchored then
			local dir = p.Position - hp
			dir = Vector3.new(dir.X, 0, dir.Z)
			dir = dir.Magnitude > 0.1 and dir.Unit or Vector3.xAxis
			pcall(function()
				p.AssemblyLinearVelocity = dir * 20 + Vector3.new(0, 8, 0)
			end)
		end
	end
end

-- ===================== NPC KILL (network ownership) =====================
-- you own the NPC's physics (simulation radius), so its parts get broken apart and dropped under FallenPartsDestroyHeight.
-- the server sees them fall, destroys them and the NPC dies. only NPCs: any player model (with or without this script) is skipped
local killing = setmetatable({}, { __mode = "k" })
function U.killNPC(model)
	if not model or killing[model] or not model.Parent then return end
	if Players:GetPlayerFromCharacter(model) then return end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	killing[model] = true
	U.claimOwnership()
	task.spawn(function()
		pcall(function() hum.Health = 0 end)
		pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
		pcall(function() model:BreakJoints() end)
		local parts = {}
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				parts[#parts + 1] = d
				pcall(function()
					d.Anchored = false
					d.CanCollide = false
					d.CanTouch = false
				end)
			end
		end
		local fh = workspace.FallenPartsDestroyHeight
		local voidY = (fh > -1e5) and (fh - 400) or -1e5
		local t0 = os.clock()
		while model.Parent and os.clock() - t0 < 3 do
			for _, p in ipairs(parts) do
				if p.Parent then
					pcall(function()
						p.AssemblyLinearVelocity = Vector3.new(0, -2000, 0)
						p.CFrame = CFrame.new(p.Position.X, voidY, p.Position.Z)
					end)
				end
			end
			RunService.Heartbeat:Wait()
		end
		killing[model] = nil
	end)
end

