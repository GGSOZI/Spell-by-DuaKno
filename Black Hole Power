	local ragdolled = false
	local safePos = nil
	local volK = 1
	if remote then
		local lr = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		volK = lr and math.clamp(1 - (lr.Position - hp).Magnitude / 300, 0.1, 1) or 0.5
