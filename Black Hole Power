-- safe hub calls: an error inside SpellsFx can no longer kill a cast or leave effects stuck
local FxSafe = {}
do
	local warned = {}
	local function call(k, ...)
		local f = Fx[k]
		if type(f) ~= "function" then return nil end
		local ok, r = pcall(f, ...)
		if not ok then
			if not warned[k] then warned[k] = true warn("[SpellsFx." .. tostring(k) .. "] " .. tostring(r)) end
			return nil
		end
		return r
	end
	setmetatable(FxSafe, { __index = function(_, k) return function(...) return call(k, ...) end end })
	function FxSafe.players(...)
		local r = call("playersInRadius", ...)
		return type(r) == "table" and r or {}
	end
end

-- victim side: when a cast from another script user lands on YOU, your own script applies the effect to your own
-- character (only players running these scripts ever receive the cast). capped, expires by itself, 1.2s immunity after a freeze
local SelfFx = {}
do
	local tok, saved, immune = 0, nil, 0
	local function mine()
		local ch = lp.Character
		return ch, ch and ch:FindFirstChildOfClass("Humanoid"), ch and ch:FindFirstChild("HumanoidRootPart")
	end
	function SelfFx.near(pos, rad)
		local _, hum, root = mine()
		return root ~= nil and hum ~= nil and hum.Health > 0 and (root.Position - pos).Magnitude <= rad
	end
	function SelfFx.freeze(dur)
		local ch, hum, root = mine()
		if not (hum and root) or hum.Health <= 0 or os.clock() < immune then return false end
		dur = math.clamp(tonumber(dur) or 2, 0.2, 4)
		tok += 1
		local my = tok
		if not saved or saved.ch ~= ch then
			saved = { ch = ch, ws = hum.WalkSpeed, jp = hum.JumpPower, jh = hum.JumpHeight, ar = hum.AutoRotate }
		end
		local untilT = os.clock() + dur
		task.spawn(function()
			while my == tok and os.clock() < untilT and ch.Parent and hum.Health > 0 do
				pcall(function()
					root.AssemblyLinearVelocity = Vector3.zero
					root.AssemblyAngularVelocity = Vector3.zero
					root.Anchored = true
					hum.WalkSpeed, hum.JumpPower, hum.JumpHeight, hum.AutoRotate = 0, 0, 0, false
				end)
				RunService.Heartbeat:Wait()
			end
			if my ~= tok then return end
			local s = saved
			saved = nil
			immune = os.clock() + 1.2
			pcall(function()
				root.Anchored = false
				if s and s.ch == ch then
					hum.WalkSpeed, hum.JumpPower, hum.JumpHeight, hum.AutoRotate = s.ws, s.jp, s.jh, s.ar
				end
			end)
		end)
		return true
	end
	function SelfFx.push(dir, power)
		local _, hum, root = mine()
		if not (hum and root) or hum.Health <= 0 then return end
		local flat = Vector3.new(dir.X, 0, dir.Z)
		flat = flat.Magnitude > 0.05 and flat.Unit or Vector3.zero
		power = math.clamp(tonumber(power) or 8, 0, 22)
		pcall(function() root.AssemblyLinearVelocity = flat * power * 1.5 + Vector3.new(0, power * 0.6, 0) end)
	end
end
