		lens.Reflectance = 0
		lens.Transparency = CONFIG.LensTransparency
		lens.Size = Vector3.one * CONFIG.StartDiameter * CONFIG.LensScale
		lens.CFrame = CFrame.new(hp)
		lens.Parent = folder
	end

	local att = Instance.new("Attachment")
	att.Parent = core

	local E = {}
	for name in pairs(DEFS) do
		E[name] = U.buildEmitter(name, att)
	end

	local active = {}
	for name, d in pairs(DEFS) do
		if d.continuous then
			E[name].Enabled = true
			active[#active + 1] = name
