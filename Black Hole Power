		local tp = FxSafe.playerAt(mouse, 12)
		FxSafe.emit("blackhole", "cast", { pos = Fx.vec(targetPos) }, tp and tp.UserId)
	end
	local folder = Instance.new("Folder")
	folder.Name = "BlackHole_" .. tostring(math.random(1000, 9999))
	folder.Parent = workspace

	local hp = targetPos + Vector3.new(0, CONFIG.HeightAbove, 0)
	local F = {}
	local softened = {}

	local core = Instance.new("Part")
	core.Name = "Core"
	core.Shape = Enum.PartType.Ball
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.CanTouch = false
	core.CastShadow = false
	core.Material = Enum.Material.Neon
	core.Color = BLACK
	core.Reflectance = 0
	core.Size = Vector3.one * CONFIG.StartDiameter
	core.CFrame = CFrame.new(hp)
	core.Parent = folder

