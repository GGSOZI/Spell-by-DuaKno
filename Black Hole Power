	function F.playSound(id, vol, looped)
		local snd = Instance.new("Sound")
		snd.SoundId = "rbxassetid://" .. id
		snd.Volume = vol * volK
		snd.Looped = looped or false
		snd.Parent = SoundService
		snd:Play()
		return snd
	end

	local launchSnd = F.playSound(CONFIG.Sounds.Launch, 1)
	Debris:AddItem(launchSnd, 15)
	local activeSnd = F.playSound(CONFIG.Sounds.Active, 0.35, true)
	Debris:AddItem(activeSnd, CONFIG.Duration + 5)

	local list, captured = {}, {}
	local t0 = os.clock()
	local scanAcc, fxAcc, claimAcc, pullAcc = 1, 1, 0, 0
	local npcRoots = {}
	local burstT = {lightning = 0, debris = 0, colkor = 0}
	local lightningFlip = false
	local diameter = CONFIG.StartDiameter
	local range = CONFIG.RangeBase + diameter * CONFIG.RangePerDiameter
	local conn

	local fxI, fxEnd = 0, nil

	function F.finish()
		if not F.done then
			F.done = true
			if remote then remoteHoles[F.teardown] = nil end
			onFinished()
		end
	end

	-- unowned-by-you parts near you stop colliding so the pull can't shove your character
	function F.soften(root)
		if softened[root] then
			return
		end
		local rec = {}
		local ok, parts = pcall(function() return root:GetConnectedParts(true) end)
		if ok then
			for _, bp in ipairs(parts) do
				if bp.CanCollide then
					rec[bp] = true
					pcall(function() bp.CanCollide = false end)
				end
			end
		end
		softened[root] = rec
	end

	function F.unsoften(root)
		local rec = softened[root]
		if not rec then
			return
		end
		for bp in pairs(rec) do
			pcall(function() bp.CanCollide = true end)
		end
		softened[root] = nil
	end

	function F.restoreSoft()
		for root in pairs(softened) do
			F.unsoften(root)
		end
	end

	local ents = {}
	local DROP = {Script = true, LocalScript = true, Sound = true, ParticleEmitter = true, Beam = true, Trail = true, Fire = true, Smoke = true, Sparkles = true, PointLight = true, SpotLight = true, SurfaceLight = true, BillboardGui = true, SurfaceGui = true, Highlight = true}
		local fxOp = OverlapParams.new()
	fxOp.FilterType = Enum.RaycastFilterType.Exclude
	fxOp.FilterDescendantsInstances = {folder}
	fxOp.MaxParts = 1200

	function F.pathOf(root, inst)
		local names = {}
		local cur = inst
		while cur and cur ~= root do
			table.insert(names, 1, cur.Name)
			cur = cur.Parent
		end
		return names
	end
	function F.resolve(root, names)
		local cur = root
		for _, n in ipairs(names) do
			cur = cur and cur:FindFirstChild(n)
		end
		return cur
	end
	function F.charOf(part)
		local cur = part.Parent
		while cur and cur ~= workspace do
			if cur:IsA("Model") and cur:FindFirstChildOfClass("Humanoid") then
				return cur
			end
			cur = cur.Parent
		end
		return nil
	end

	function F.restoreRec(rec)
		pcall(function() rec.o.LocalTransparencyModifier = 0 end)
		if DECAL_LTM then
			for _, dc in ipairs(rec.decals) do
				pcall(function() dc.LocalTransparencyModifier = 0 end)
			end
		end
	end

	function F.removeEntity(src)
		local e = ents[src]
		if not e then
			return
		end
		for _, rec in ipairs(e.recs) do
			F.restoreRec(rec)
		end
		pcall(function() e.clone:Destroy() end)
		ents[src] = nil
	end

	function F.clearEntities()
		if F.stepConn then
			F.stepConn:Disconnect()
			F.stepConn = nil
		end
		for src in pairs(ents) do
			F.removeEntity(src)
		end
	end

	function F.makeEntity(src)
		local c
		local okc = pcall(function()
			local was = src.Archivable
			src.Archivable = true
			c = src:Clone()
			src.Archivable = was
		end)
		if not okc or not c then
			return false
		end

		local recs = {}
		local all = c:GetDescendants()
		all[#all + 1] = c
		for _, d in ipairs(all) do
			if d:IsA("BasePart") then
				local o = (d == c) and src or F.resolve(src, F.pathOf(c, d))
				if o and o:IsA("BasePart") then
					local rec = {o = o, c = d, decals = {}, meshes = {}}
					for _, ch in ipairs(o:GetChildren()) do
						if ch:IsA("Decal") then
							rec.decals[#rec.decals + 1] = ch
						end
					end
					for _, ch in ipairs(d:GetChildren()) do
						if ch:IsA("SpecialMesh") and ch.MeshType == Enum.MeshType.FileMesh then
							rec.meshes[#rec.meshes + 1] = {m = ch, base = ch.Scale}
						end
					end
					recs[#recs + 1] = rec
				end
			end
		end
		if #recs == 0 then
			c:Destroy()
			return false
		end

		for _, d in ipairs(c:GetDescendants()) do
			if DROP[d.ClassName] or d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Constraint") or d:IsA("BodyMover") then
				d:Destroy()
			end
		end
		local inert = c:GetDescendants()
		inert[#inert + 1] = c
		for _, d in ipairs(inert) do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				d.Massless = true
			end
		end
		for _, h in ipairs(c:GetDescendants()) do
			if h:IsA("Humanoid") then
				pcall(function()
					h.RequiresNeck = false
					h.BreakJointsOnDeath = false
					h.EvaluateStateMachine = false
					h.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
					h.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
				end)
			end
		end
		c.Parent = folder
		ents[src] = {clone = c, recs = recs}
		return true
	end

	function F.refreshEntities()
		if fxEnd then
			return
		end
		local rs = range * CONFIG.BendRangeMult
		local found = workspace:GetPartBoundsInRadius(hp, rs, fxOp)
		local cand, seen = {}, {}
		for _, part in ipairs(found) do
			if not part:IsA("Terrain") and part.Transparency < 0.98 then
				local src = F.charOf(part)
				if src then
					if not seen[src] then
						seen[src] = true
						cand[#cand + 1] = {src, (src.PrimaryPart or part).Position}
					end
				elseif not seen[part] then
					local sz = part.Size
					if math.max(sz.X, sz.Y, sz.Z) <= CONFIG.BendMaxPartSize then
						seen[part] = true
						cand[#cand + 1] = {part, part.Position}
					end
				end
			end
		end
		table.sort(cand, function(a, b)
			return (a[2] - hp).Magnitude < (b[2] - hp).Magnitude
		end)

		local want = {}
		local budgetE, budgetP, made = CONFIG.BendMaxEntities, CONFIG.BendMaxParts, 0
		for _, cd in ipairs(cand) do
			if budgetE <= 0 or budgetP <= 0 then
				break
			end
			local src = cd[1]
			if ents[src] then
				want[src] = true
				budgetE -= 1
				budgetP -= #ents[src].recs
			elseif made < CONFIG.BendNewPerTick and F.makeEntity(src) then
				made += 1
				want[src] = true
				budgetE -= 1
				budgetP -= #ents[src].recs
			end
		end
		for src in pairs(ents) do
			if not want[src] then
				F.removeEntity(src)
			end
		end
	end

	function F.applyDeform(strength, now)
		local rs = range * CONFIG.BendRangeMult
		for _, e in pairs(ents) do
			for _, rec in ipairs(e.recs) do
				local o, pp = rec.o, rec.c
				if o.Parent and pp.Parent then
					if pp.CanCollide then
						pp.CanCollide = false
					end
					o.LocalTransparencyModifier = 1
					if DECAL_LTM then
						for _, dc in ipairs(rec.decals) do
							dc.LocalTransparencyModifier = 1
						end
					end

					local cf, sz = o.CFrame, o.Size
					local off = cf.Position - hp
					local d = off.Magnitude
					local s = (math.clamp(1 - d / rs, 0, 1) ^ 1.2) * strength
					if s < 0.004 or d < 0.05 then
						pp.CFrame = cf
						pp.Size = sz
						for _, mm in ipairs(rec.meshes) do
							mm.m.Scale = mm.base
						end
					else
						local ang = s * s * CONFIG.BendSwirl * (1 + 0.35 * math.sin(now * 1.7))
						local rh = (CFrame.Angles(0, ang, 0) * off) / d
						local wave = math.sin(d * 0.3 - now * 5) * CONFIG.BendRipple * s
						local nd = math.max(d * (1 - s * CONFIG.BendPull) + wave, diameter * 0.55)
						local pos = hp + rh * nd

						local rot = cf - cf.Position
						local axis = Vector3.yAxis:Cross(-rh)
						if axis.Magnitude > 0.01 then
							rot = CFrame.fromAxisAngle(axis.Unit, s * CONFIG.BendTilt) * rot
						end
						rot = CFrame.fromAxisAngle(rh, s * CONFIG.BendTwist * math.sin(now * 2 + d * 0.2)) * rot
						local ncf = CFrame.new(pos) * rot

						local kr = 1 - s * CONFIG.BendRadial
						local kt = 1 + s * CONFIG.BendTangent
						local lr = ncf:VectorToObjectSpace(rh)
						local nsz = Vector3.new(
							sz.X * (kt + (kr - kt) * lr.X * lr.X),
							sz.Y * (kt + (kr - kt) * lr.Y * lr.Y),
							sz.Z * (kt + (kr - kt) * lr.Z * lr.Z)
						)

						pp.CFrame = ncf
						pp.Size = nsz
						for _, mm in ipairs(rec.meshes) do
							mm.m.Scale = mm.base * Vector3.new(nsz.X / sz.X, nsz.Y / sz.Y, nsz.Z / sz.Z)
						end
					end
				end
			end
		end
	end

	F.stepConn = RunService.Stepped:Connect(function()
		for _, e in pairs(ents) do
			for _, rec in ipairs(e.recs) do
				local cp = rec.c
				if cp.Parent and cp.CanCollide then
					cp.CanCollide = false
				end
			end
		end
	end)

	local camName = "BlackHoleCam_" .. folder.Name .. tostring(math.floor(os.clock() * 1000))
	function F.teardown()
		if conn then
			pcall(function() conn:Disconnect() end)
		end
		pcall(function() RunService:UnbindFromRenderStep(camName) end)
		pcall(F.clearEntities)
		pcall(F.restoreSoft)
		pcall(function() blur:Destroy() end)
		pcall(function() cc:Destroy() end)
		pcall(function() activeSnd:Destroy() end)
		pcall(function() folder:Destroy() end)
		pcall(function() cam.FieldOfView = baseFov end)
		local h = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
		if h then
			pcall(function()
				h.CameraOffset = Vector3.zero
				if ragdolled then
					h.PlatformStand = false
				end
			end)
		end
	end
	if remote then
		remoteHoles[F.teardown] = true
	else
		env.BlackHoleFxClear = F.teardown
	end

	RunService:BindToRenderStep(camName, Enum.RenderPriority.Camera.Value + 1, function()
		local now = os.clock()
		local I, relax = fxI, 1
		if fxEnd then
			local x = math.clamp((now - fxEnd) / 1.2, 0, 1)
			relax = 1 - x
			I = I * relax
			if x >= 1 then
				RunService:UnbindFromRenderStep(camName)
				F.clearEntities()
				return
			end
		end

		local camPos = cam.CFrame.Position
		local toHole = hp - camPos
		local dist = toHole.Magnitude
		if (CONFIG.CamPull > 0 or CONFIG.CamRoll ~= 0) and I > 0.01 and dist > 1 then
			local bent = cam.CFrame.LookVector:Lerp(toHole / dist, I * CONFIG.CamPull)
			if bent.Magnitude > 0.01 then
				local roll = I * math.rad(CONFIG.CamRoll) * (math.sin(now * 2.3) * 0.6 + math.sin(now * 6.1) * 0.4)
				cam.CFrame = CFrame.lookAt(camPos, camPos + bent) * CFrame.Angles(0, 0, roll)
			end
		end

		local a = math.clamp((now - t0) / CONFIG.Duration, 0, 1)
		F.applyDeform(relax * (0.3 + 0.7 * a), now)
	end)

	function F.rescale()
		local k = diameter / 20
		for name, e in pairs(E) do
			local d = DEFS[name]
			pcall(function() e.Size = U.NS(d.size, k * CONFIG.ParticleScale * (d.cs or 1)) end)
		end
	end

	function F.scan()
		if remote then
			list = {}
			return
		end
		U.setFilter(folder)
		local found = workspace:GetPartBoundsInRadius(hp, range, overlap)
		local newList, newNpc = {}, {}
		for _, p in ipairs(found) do
			local root = p.AssemblyRootPart
			if root and not root.Anchored then
				local model, isPlayer = U.getNpc(p)
				if model then
					newList[#newList + 1] = p
					newNpc[root] = true
					if not captured[model] then
						captured[model] = true
					end
					local hum = model:FindFirstChildOfClass("Humanoid")
					if hum then
						pcall(function() hum.PlatformStand = true end)
						pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
					end
				elseif not isPlayer then
					newList[#newList + 1] = p
				end
			end
		end
		list = newList
		npcRoots = newNpc
	end

	local function step(dt)
		local t = os.clock() - t0
		local a = math.clamp(t / CONFIG.Duration, 0, 1)
		diameter = CONFIG.StartDiameter + (CONFIG.EndDiameter - CONFIG.StartDiameter) * a
		range = CONFIG.RangeBase + diameter * CONFIG.RangePerDiameter
		core.Size = Vector3.one * diameter
		if lens then
			lens.Size = Vector3.one * diameter * CONFIG.LensScale
		end

		scanAcc += dt
		if scanAcc >= 0.2 then
			scanAcc = 0
			F.scan()
			F.refreshEntities()
		end

		claimAcc += dt
		if claimAcc >= 1 then
			claimAcc = 0
			if not remote then U.claimOwnership() end
		end

		pullAcc += dt
		if pullAcc >= 0.5 and not remote then
			pullAcc = 0
			local sent = 0
			for _, plr in ipairs(FxSafe.players(hp, range, false)) do
				local pr = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if pr and sent < 6 then
					sent += 1
					FxSafe.status(plr.UserId, "pull", 0.9, { pos = Fx.vec(hp), s = 14 + 10 * a }, "blackhole")
				end
			end
		end

		fxAcc += dt
		if fxAcc >= 0.1 then
			fxAcc = 0
			F.rescale()
		end

		burstT.lightning += dt
		if burstT.lightning >= 0.3 then
			burstT.lightning = 0
			lightningFlip = not lightningFlip
			E[lightningFlip and "BrightLightning" or "BrightLightning2"]:Emit(2)
		end
		burstT.debris += dt
		if burstT.debris >= 0.6 then
			burstT.debris = 0
			E.C1:Emit(6)
			E.C2:Emit(6)
		end
		burstT.colkor += dt
		if burstT.colkor >= 0.8 then
			burstT.colkor = 0
			E.Colkor:Emit(4)
		end

		local accel = CONFIG.PullMin + (CONFIG.PullMax - CONFIG.PullMin) * a
		local maxSpeed = CONFIG.MaxSpeedMin + (CONFIG.MaxSpeedMax - CONFIG.MaxSpeedMin) * a
		local seen = {}
		local grav = workspace.Gravity
		local pChar = lp.Character
		local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")

		for i = #list, 1, -1 do
			local p = list[i]
			if not p.Parent then
				table.remove(list, i)
			else
				local root = p.AssemblyRootPart
				if root and not seen[root] and not root.Anchored then
					seen[root] = true
					if pRoot then
						local nd = (root.Position - pRoot.Position).Magnitude
						if nd < 16 then
							F.soften(root)
						elseif nd > 28 and softened[root] then
							F.unsoften(root)
						end
					end
					local off = hp - root.Position
					local d = off.Magnitude
					if d < range and d > 0.05 then
						local u = off / d
						local f = (1 - d / range) ^ 2
						local push = accel * f
						local swirl = u:Cross(Vector3.yAxis) * push * CONFIG.Swirl
						local v = root.AssemblyLinearVelocity + (u * push + swirl + Vector3.new(0, grav, 0)) * dt
						if d < diameter * 0.6 then
							v = v * 0.92
						end
						local sp = v.Magnitude
						local capSp = npcRoots[root] and 26 or math.min(maxSpeed, 40)
						if sp > capSp then
							v = v / sp * capSp
						end
						root.AssemblyLinearVelocity = v
						root.AssemblyAngularVelocity = Vector3.new(f * 8, f * 12, f * 6)
					end
				end
			end
		end

		local char = lp.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		local myHum = char and char:FindFirstChildOfClass("Humanoid")
		local intensity = 0
		local pullF = 0
		if hrp then
			local off = hp - hrp.Position
			local d = off.Magnitude
			local proximity = math.clamp(1 - d / (range * CONFIG.DistortRangeMult), 0, 1)
			pullF = d < range and (1 - d / range) ^ 2 or 0
			intensity = (proximity ^ 1.3 * 0.7 + pullF * 0.3) * (0.35 + 0.65 * a)
			intensity = math.clamp(intensity * 1.15, 0, 1)
			if CONFIG.PullPlayer and d < range and d > 0.05 then
				local u = off / d
				local f = (1 - d / range) ^ 2
				local ramp = math.clamp(t / 1.5, 0, 1)
				local push = accel * f * CONFIG.PlayerPullMult * ramp
				local swirl = u:Cross(Vector3.yAxis) * push * CONFIG.PlayerSwirl
				local v = hrp.AssemblyLinearVelocity + (u * push + swirl + Vector3.new(0, grav * 0.6 * ramp, 0)) * dt
				local sp = v.Magnitude
				local cap = math.min(maxSpeed * 0.8, CONFIG.PlayerMaxSpeed)
				if sp > cap then
					v = v / sp * cap
				end
				hrp.AssemblyLinearVelocity = v
			end
			if myHum and myHum.FloorMaterial ~= Enum.Material.Air then
				safePos = hrp.Position
			end
			if myHum then
				if d < range * 0.5 then
					myHum.PlatformStand = true
					ragdolled = true
				elseif ragdolled then
					myHum.PlatformStand = false
					ragdolled = false
				end
			end
		end

		fxI = intensity
		blur.Size = intensity * 8
		cc.Saturation = -intensity * 0.35
		cc.Contrast = intensity * 0.15
		cc.Brightness = -intensity * 0.08
		cc.TintColor = Color3.new(1, 1 - intensity * 0.15, 1 - intensity * 0.15)
		cam.FieldOfView = baseFov + intensity * CONFIG.FovMax * (0.6 + 0.4 * math.sin(t * 12))
		if myHum then
			local amt = intensity * CONFIG.ShakeMax * 2 + pullF * a * CONFIG.ShakeMax + a * 0.05
			myHum.CameraOffset = Vector3.new((math.random() - 0.5) * amt, (math.random() - 0.5) * amt, 0)
		end
		activeSnd.Volume = (0.35 + 0.65 * a) * volK
		activeSnd.PlaybackSpeed = 0.9 + 0.2 * a

		if t >= CONFIG.Duration then
			conn:Disconnect()
			fxEnd = os.clock()

			activeSnd:Stop()
			activeSnd:Destroy()
			local explodeSnd = F.playSound(CONFIG.Sounds.Explode, 1)
			Debris:AddItem(explodeSnd, 15)

			if myHum then
				myHum.CameraOffset = Vector3.zero
				if ragdolled then
					myHum.PlatformStand = false
				end
			end
			task.spawn(function()
				local b0, s0, c0 = 12, cc.Saturation, cc.Contrast
				local br0 = 0.15
				local fov0 = cam.FieldOfView
				blur.Size = b0
				cc.Brightness = br0
				local t1 = os.clock()
				while true do
					local x = math.clamp((os.clock() - t1) / 1.2, 0, 1)
					blur.Size = b0 * (1 - x)
					cc.Saturation = s0 * (1 - x)
					cc.Contrast = c0 * (1 - x)
					cc.Brightness = br0 * (1 - x)
					cc.TintColor = Color3.new(1, 1, 1)
					cam.FieldOfView = fov0 + (baseFov - fov0) * x
					if x >= 1 then
						break
					end
					RunService.RenderStepped:Wait()
				end
				blur:Destroy()
				cc:Destroy()
			end)

			if not remote then U.claimOwnership() end
			for _, name in ipairs(active) do
				E[name].Enabled = false
			end

			local k = diameter / 20
			for name, e in pairs(E) do
				local d = DEFS[name]
				pcall(function() e.Size = U.NS(d.size, k * 1.5 * CONFIG.ParticleScale * (d.cs or 1)) end)
			end

			E.Blast:Emit(15)
			E.BlackShockwave:Emit(2)
			E.BlackShockwave2:Emit(2)
			E.Shockwave:Emit(1)
			E.BlackFlashWind:Emit(15)
			E.BlackDust:Emit(30)
			E.C1:Emit(25)
			E.C2:Emit(25)
			E.Colkor:Emit(8)
			E.BrightLightning:Emit(6)
			E.BrightLightning2:Emit(6)

			core.Transparency = 1
			if lens then
				lens.Transparency = 1
			end

			local char = lp.Character
			local rootPart = char and char:FindFirstChild("HumanoidRootPart")
			if rootPart then
				local dist = (rootPart.Position - hp).Magnitude
				U.shake(math.clamp(1 - dist / (range * 2), 0, 1) * CONFIG.ExplodeShake)
			end

			if rootPart then
				local poff = rootPart.Position - hp
				local flat = Vector3.new(poff.X, 0, poff.Z)
				local pdir = flat.Magnitude > 0.5 and flat.Unit or Vector3.zero
				local pf = math.clamp(1 - poff.Magnitude / (range * CONFIG.KillRangeMult), 0, 1)
				pcall(function()
					rootPart.AssemblyAngularVelocity = Vector3.zero
					rootPart.AssemblyLinearVelocity = pdir * CONFIG.PlayerBlast * pf + Vector3.new(0, CONFIG.PlayerBlastUp * pf, 0)
				end)
				-- safety net: rescue from the void
				task.spawn(function()
					local untilT = os.clock() + 8
					while os.clock() < untilT do
						local c2 = lp.Character
						local r2 = c2 and c2:FindFirstChild("HumanoidRootPart")
						if r2 and safePos and r2.Position.Y < workspace.FallenPartsDestroyHeight + 150 then
							r2.AssemblyLinearVelocity = Vector3.zero
							r2.CFrame = CFrame.new(safePos + Vector3.new(0, 4, 0))
							break
						end
						task.wait(0.1)
					end
				end)
			end

			U.setFilter(folder)
			local blastRange = range * CONFIG.KillRangeMult
			local found = remote and {} or workspace:GetPartBoundsInRadius(hp, blastRange, overlap)
			local done = {}
			for _, p in ipairs(found) do
				local root = p.AssemblyRootPart
				if root and not root.Anchored and not done[root] then
					local model, isPlayer = U.getNpc(p)
					if not isPlayer and not model then
						done[root] = true
						local off = root.Position - hp
						local d = off.Magnitude
						local dir = d > 0.1 and off / d or Vector3.yAxis
						local f = math.clamp(1 - d / blastRange, 0.15, 1)
						pcall(function()
							root.AssemblyLinearVelocity = dir * CONFIG.BlastPower * f + Vector3.new(0, 8 * f, 0)
						end)
					end
				end
			end

			if not remote then -- every NPC in the blast dies instantly (players are never touched)
				for _, p in ipairs(found) do
					local m = U.getNpc(p)
					if m then U.killNPC(m) end
				end
			end
			for model in pairs(captured) do
				if model.Parent then
					local mroot = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
					if mroot and (mroot.Position - hp).Magnitude <= blastRange then
						U.killNPC(model)
					else
						local hum = model:FindFirstChildOfClass("Humanoid")
						if hum then
							pcall(function() hum.PlatformStand = false end)
							pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
						end
					end
				end
			end

			if not remote then
				for _, plr in ipairs(FxSafe.players(hp, blastRange, false)) do
					local pr = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
					if pr then
						local off = pr.Position - hp
						local f = math.clamp(1 - off.Magnitude / blastRange, 0.3, 1)
						FxSafe.push(plr.UserId, off, 22 * f, "blackhole")
					end
				end
			end

			task.delay(0.6, F.restoreSoft)
			Debris:AddItem(folder, 5)
			if not remote then env.BlackHoleFxClear = nil end
			F.finish()
		end
	end

	local errCount = 0
	conn = RunService.Heartbeat:Connect(function(dt)
		local ok, err = pcall(step, dt)
		if ok then errCount = 0 return end
		errCount += 1
		if errCount == 1 then warn("[BlackHole] step error: " .. tostring(err)) end
		if errCount >= 8 and not fxEnd then
			F.teardown()
			if not remote then env.BlackHoleFxClear = nil end
			F.finish()
		end
	end)
end

-- another player's black hole, replayed as visuals (no part physics, the push on you comes from the caster through SpellsFx)
local function remotePlay(pkt)
	if pkt.kind ~= "cast" or type(pkt.d) ~= "table" then return end
	local pos = Fx.unvec(pkt.d.pos)
	if not pos then return end
	task.spawn(function()
		pcall(spawnBlackHole, pos, function() end, true)
	end)
end

local function remoteStop()
	for stopHole in pairs(table.clone(remoteHoles)) do
		pcall(stopHole)
	end
	table.clear(remoteHoles)
end

FxSafe.register("blackhole", { play = remotePlay, stop = remoteStop }, FX_PATH)
if VIEWER then return end

local tool

local function startCooldown()
	task.spawn(function()
		for i = CONFIG.Cooldown, 1, -1 do
			if tool and tool.Parent then
				tool.Name = "Black Hole (" .. i .. "s)"
			end
			task.wait(1)
		end
		busy = false
		if tool and tool.Parent then
			tool.Name = "Black Hole"
		end
	end)
end

local function giveTool()
	for _, container in ipairs({lp:FindFirstChildOfClass("Backpack"), lp.Character}) do
		if container then
			for _, c in ipairs(container:GetChildren()) do
				if c:GetAttribute("BlackHoleTool") then
					c:Destroy()
				end
			end
		end
	end
	tool = Instance.new("Tool")
	tool.Name = busy and "Black Hole (cooldown)" or "Black Hole"
	tool.ToolTip = "Click to summon a black hole"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool:SetAttribute("BlackHoleTool", true)
	tool.Activated:Connect(function()
		if busy then
			return
		end
		local target = mouse.Hit
		if not target then
			return
		end
		busy = true
		local ok = pcall(spawnBlackHole, target.Position, startCooldown)
		if not ok then
			if env.BlackHoleFxClear then
				pcall(env.BlackHoleFxClear)
				env.BlackHoleFxClear = nil
			end
			busy = false
		end
	end)
	tool.Parent = lp:WaitForChild("Backpack")
end

giveTool()

local charConn = lp.CharacterAdded:Connect(function()
	task.wait(1)
	giveTool()
end)

env.BlackHoleCleanup = function()
	pcall(Fx.unregister, "blackhole")
	if env.BlackHoleFxClear then
		pcall(env.BlackHoleFxClear)
	end
	charConn:Disconnect()
	if tool then
		tool:Destroy()
	end
end
