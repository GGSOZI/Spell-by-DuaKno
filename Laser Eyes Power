end

local function aimPoint(char, folder)
	local p = UIS.TouchEnabled and cam.ViewportSize / 2 or UIS:GetMouseLocation()
	cam = workspace.CurrentCamera
	local r = cam:ViewportPointToRay(p.X, p.Y)
	local res = workspace:Raycast(r.Origin, r.Direction * CFG.Range, rayParams(char, folder))
	return res and res.Position or (r.Origin + r.Direction * CFG.Range)
end

-- real surface hit from the eyes toward the (delayed) aim point
local function surfaceAt(origin, p, char, folder)
	local d = p - origin
	if d.Magnitude < 0.5 then return nil end
	return workspace:Raycast(origin, d.Unit * (d.Magnitude + 4), rayParams(char, folder))
end

local firing = false

----------------------------------------------------------------------
-- Sparks
----------------------------------------------------------------------
local function mkSparks(parent)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Rate = 80
	e.Lifetime = NumberRange.new(0.3, 0.8)
	e.Speed = NumberRange.new(20, 45)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -70, 0)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.Color = ColorSequence.new(Color3.fromRGB(255, 170, 40), Color3.fromRGB(255, 60, 0))
	e.LightEmission = 1
	e.Brightness = 3
	e.Parent = parent
	return e
end

----------------------------------------------------------------------
-- Laser
----------------------------------------------------------------------

local function fire()
	if busy or os.clock() < cdUntil then return end
	local char = lp.Character
	local head = char and char:FindFirstChild("Head")
	if not head then return end
	busy = true

	local folder = Instance.new("Folder")
	folder.Name = "LaserEyes"
	folder.Parent = workspace

	local eyes, charge, live, guides, lights, fireBeams, reticle = {}, {}, {}, {}, {}, {}, {}
	local chargeRef, fireSnd = {}, nil
	local fired = false
	local baseFov = cam.FieldOfView

	-- everything that can fail runs inside pcall so the cleanup below ALWAYS runs (no stuck beam / sound / effects)
	local ok, err = pcall(function()
		local tgt = Instance.new("Part")
		tgt.Anchored, tgt.CanCollide, tgt.CanQuery, tgt.CanTouch = true, false, false, false
		tgt.Transparency = 1
		tgt.Size = Vector3.new(0.5, 0.5, 0.5)
		tgt.Parent = folder
		local endAtt = Instance.new("Attachment", tgt)

		for i, x in ipairs({ -0.3, 0.3 }) do
			local a = Instance.new("Attachment")
			a.Name = "LaserEye" .. i
			a.Position = Vector3.new(x, 0.15, -0.55)
			a.Parent = head
			eyes[i] = a
			local l = Instance.new("PointLight")
			l.Color = Color3.new(1, 0.1, 0.05)
			l.Range = 14
			l.Brightness = 0
			l.Parent = a
			table.insert(lights, l)
		end

		for _, a in ipairs(eyes) do
			for _, n in ipairs(EYE_CHARGE) do table.insert(charge, mkEmitter(n, a, CFG.EyeScale)) end
			for k = 1, 2 do
				local g = Instance.new("Beam")
				g.Texture = "rbxassetid://135363279337264"
				g.TextureMode = E.TextureMode.Stretch
				g.Color = ColorSequence.new(k == 1 and Color3.new(1, 0.1, 0.05) or Color3.new(1, 0.85, 0.8))
				g.LightEmission = 1
				g.LightInfluence = 0
				g.FaceCamera = true
				g.Segments = 10
				g.ZOffset = k
				g.Width0, g.Width1 = 0.3, 0.3
				g.Attachment0, g.Attachment1 = a, endAtt
				g.Parent = folder
				table.insert(guides, g)
			end
		end
		reticle[1], reticle[2] = mkEmitter("ChargeA", endAtt, 0.5), mkEmitter("Almost", endAtt, 0.6)
		startChargeSound(head, CFG.ChargeTime, chargeRef)
		FxSafe.emit("lasereyes", "charge", { t = CFG.ChargeTime })

		local dt = 1 / 60
		local sm
		local function smooth(target)
			if not sm then sm = target else sm = sm:Lerp(target, 1 - math.exp(-CFG.AimSmooth * dt)) end
			return sm
		end

		local t0 = os.clock()
		while holding and char.Parent and os.clock() - t0 < CFG.ChargeTime do
			local pr = (os.clock() - t0) / CFG.ChargeTime
			shake = CFG.ShakeCharge * pr
			tgt.CFrame = CFrame.new(smooth(aimPoint(char, folder)))
			cam.FieldOfView = baseFov - CFG.FovZoom * pr
			for _, l in ipairs(lights) do l.Brightness = 1 + 4 * pr end
			local pulse = 0.5 + 0.5 * math.sin((os.clock() - t0) * (10 + 14 * pr))
			for i, g in ipairs(guides) do
				local glow = (i % 2 == 1)
				local w = glow and (0.7 + 0.9 * pr) or (0.18 + 0.25 * pr)
				g.Width0, g.Width1 = w, w
				g.Transparency = NumberSequence.new(glow and (0.35 + 0.25 * pulse) or 0)
			end
			dt = RunService.Heartbeat:Wait()
		end

		for _, g in ipairs(guides) do g:Destroy() end
		for _, e in ipairs(reticle) do e.Enabled = false end
		for _, e in ipairs(charge) do e.Enabled = false end
		chargeRef.stop = true
		if chargeRef.snd then chargeRef.snd:Destroy() end

		if holding and char.Parent then
			fired = true
			shake = CFG.ShakeFire
			TweenService:Create(cam, TweenInfo.new(0.15), { FieldOfView = baseFov + 6 }):Play()
			for _, a in ipairs(eyes) do
				for _, n in ipairs(EYE_FIRE) do table.insert(live, mkEmitter(n, a, CFG.EyeScale * 2)) end
				for _, b in ipairs(BEAMS) do
					local beam = Instance.new("Beam")
					beam.Texture = b.tex
					beam.TextureLength = b.len
					beam.TextureMode = b.mode
					beam.TextureSpeed = 1
					beam.Color = ColorSequence.new(b.col)
					beam.Transparency = seq(b.trans, 1)
					beam.LightEmission = 1
					beam.LightInfluence = 0
					beam.Width0 = b.w * CFG.BeamWidth * 0.5
					beam.Width1 = b.w * CFG.BeamWidth
					beam.Segments = 10
					beam.FaceCamera = true
					beam.ZOffset = b.z
					beam.Attachment0, beam.Attachment1 = a, endAtt
					beam.Parent = folder
					table.insert(fireBeams, { beam = beam, w0 = beam.Width0, w1 = beam.Width1 })
				end
			end
			for _, n in ipairs(HIT_FIRE) do table.insert(live, mkEmitter(n, endAtt, HIT_SCALE[n] or 1)) end
			table.insert(live, mkSparks(endAtt))
			fireSnd = playSound(SOUNDS.Fire, head, true)
			playSound(SOUNDS.Hit, tgt)
			FxSafe.emit("lasereyes", "start", { p = Fx.vec(tgt.Position) })

			firing = true
			local t1, lastScan, lastPebble, lastChunk, lastP, lastInst = os.clock(), 0, 0, 0, nil, nil
			local lastAim, lastSent = 0, nil
			while holding and char.Parent and os.clock() - t1 < CFG.MaxFire do
				local power = 1 + (CFG.MaxPower - 1) * math.clamp((os.clock() - t1) / CFG.PowerRamp, 0, 1)
				local p = smooth(aimPoint(char, folder))
				local hit = surfaceAt(head.Position, p, char, folder)
				if hit then p = hit.Position end
				tgt.CFrame = CFrame.new(p)
				shake = CFG.ShakeFire * math.sqrt(power)
				for _, fb in ipairs(fireBeams) do
					fb.beam.Width0, fb.beam.Width1 = fb.w0 * power, fb.w1 * power
				end
				for _, l in ipairs(lights) do l.Brightness = 5 * power end
				local now = os.clock()
				if now - lastAim >= 0.12 and (not lastSent or (p - lastSent).Magnitude > 1) then
					lastAim, lastSent = now, p
					FxSafe.emit("lasereyes", "aim", { p = Fx.vec(p) })
				end
				if now - lastScan >= 0.1 then
					lastScan = now
					local okS, errS = pcall(scanBeam, head.Position, p, char, folder, power)
					if not okS then warn("[LaserEyes] scan: " .. tostring(errS)) end
				end
				local moveVel = Vector3.zero
				if lastP then
					local v = (p - lastP) / math.max(dt, 1 / 120)
					v = Vector3.new(v.X, 0, v.Z)
					moveVel = v.Magnitude > 80 and v.Unit * 80 or v
				end
				lastP = p
				local solid = CFG.GroundFX and hit and isSolid(hit)
				if solid then
					if now - lastPebble >= CFG.PebbleEvery then
						lastPebble = now
						pcall(groundFX, hit, moveVel, false)
					end
					if hit.Instance ~= lastInst and now - lastChunk >= CFG.ChunkEvery then
						lastChunk = now
						pcall(groundFX, hit, moveVel, true)
					end
				end
				lastInst = solid and hit.Instance or nil
				dt = RunService.Heartbeat:Wait()
			end
		end
	end)
	if not ok then warn("[LaserEyes] " .. tostring(err)) end

	-- cleanup: always runs
	firing = false
	holding = false
	chargeRef.stop = true
	if chargeRef.snd then pcall(function() chargeRef.snd:Destroy() end) end
	if fireSnd then pcall(function() fireSnd:Destroy() end) end
	FxSafe.emit("lasereyes", "stop", {})
	shake = 0
	pcall(function() TweenService:Create(cam, TweenInfo.new(0.4), { FieldOfView = baseFov }):Play() end)
	for _, g in ipairs(guides) do pcall(function() g:Destroy() end) end
	for _, l in ipairs(lights) do pcall(function() l:Destroy() end) end
	for _, group in ipairs({ reticle, charge, live }) do
		for _, e in ipairs(group) do pcall(function() e.Enabled = false end) end
	end
	for _, c in ipairs(folder:GetChildren()) do
		if c:IsA("Beam") then pcall(function() c:Destroy() end) end
	end
	for _, a in ipairs(eyes) do Debris:AddItem(a, 4) end
	Debris:AddItem(folder, 4)
	if fired then
		cdUntil = os.clock() + CFG.Cooldown
		pcall(function() CAS:SetTitle(ACTION, "WAIT") end)
		task.delay(CFG.Cooldown, function() pcall(function() CAS:SetTitle(ACTION, "LASER") end) end)
	end
	busy = false
end

----------------------------------------------------------------------
-- Other players' lasers (visual replay from firebase events, one session per caster)
----------------------------------------------------------------------
local sessions = {}
local remoteConn

local function endSession(s)
	if s.dead then return end
	s.dead = true
	if sessions[s.id] == s then sessions[s.id] = nil end
	for _, e in ipairs(s.emitters) do pcall(function() e.Enabled = false end) end
	for _, l in ipairs(s.lights) do pcall(function() l:Destroy() end) end
	for _, b in ipairs(s.beams) do pcall(function() b.beam:Destroy() end) end
	if s.snd then pcall(function() s.snd:Destroy() end) end
	for _, a in ipairs(s.eyes) do Debris:AddItem(a, 4) end
	Debris:AddItem(s.folder, 4)
end

local lastSelfPush = 0
local function visualBeam(ss, now)
	local from, to = ss.head.Position, ss.cur
	local op = OverlapParams.new()
	op.FilterType = E.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = { ss.char, ss.folder }
	local power = 1 + (CFG.MaxPower - 1) * math.clamp((now - ss.fireAt) / CFG.PowerRamp, 0, 1)
	local n = math.clamp(math.floor((to - from).Magnitude / CFG.BeamStep), 1, 30)
	local seen = {}
	for i = 0, n do
		local r = ((i == n) and CFG.KillRadius or CFG.BeamRadius) * power
		for _, part in ipairs(workspace:GetPartBoundsInRadius(from:Lerp(to, i / n), r, op)) do
			local m = part.Parent
			while m and m ~= workspace do
				if m:IsA("Model") and m:FindFirstChildOfClass("Humanoid") then
					if not seen[m] then
						seen[m] = true
						local bb = ignite(m)
						bb.last = os.clock()
						if m == lp.Character and now - lastSelfPush >= 0.8 then
							lastSelfPush = now
							local root = m:FindFirstChild("HumanoidRootPart")
							if root then SelfFx.push(root.Position - from, 12) end
						end
					end
					break
				end
				m = m.Parent
			end
		end
	end
end

local function newSession(pkt)
	local char = pkt.caster and pkt.caster.Character
	local head = char and char:FindFirstChild("Head")
	if not head then return nil end
	local old = sessions[pkt.casterId]
	if old then endSession(old) end
	local s = { id = pkt.casterId, head = head, char = char, born = os.clock(), last = os.clock(), phase = "charge", emitters = {}, beams = {}, eyes = {}, lights = {} }
	s.folder = Instance.new("Folder")
	s.folder.Name = "LaserEyesRemote"
	s.folder.Parent = workspace
	local tgt = Instance.new("Part")
	tgt.Anchored, tgt.CanCollide, tgt.CanQuery, tgt.CanTouch = true, false, false, false
	tgt.Transparency = 1
	tgt.Size = Vector3.new(0.5, 0.5, 0.5)
	tgt.CFrame = head.CFrame * CFrame.new(0, 0, -20)
	tgt.Parent = s.folder
	s.tgt = tgt
	s.endAtt = Instance.new("Attachment", tgt)
	for i, x in ipairs({ -0.3, 0.3 }) do
		local a = Instance.new("Attachment")
		a.Name = "LaserEyeRemote" .. i
		a.Position = Vector3.new(x, 0.15, -0.55)
		a.Parent = head
		s.eyes[i] = a
		local l = Instance.new("PointLight")
		l.Color = Color3.new(1, 0.1, 0.05)
		l.Range = 14
		l.Brightness = 1
		l.Parent = a
		table.insert(s.lights, l)
	end
	sessions[s.id] = s
	if not remoteConn then
		remoteConn = RunService.Heartbeat:Connect(function(dt)
			local now = os.clock()
			for _, ss in pairs(table.clone(sessions)) do
				if ss.dead or not ss.head.Parent or not ss.head:IsDescendantOf(workspace) then
					endSession(ss)
				elseif now - ss.born > CFG.MaxFire + CFG.ChargeTime + 2 or (ss.phase == "charge" and now - ss.born > CFG.ChargeTime + 1.5) or (ss.phase == "fire" and now - ss.last > 1.5) then
					endSession(ss)
				elseif ss.phase == "fire" and ss.goal then
					ss.cur = ss.cur and ss.cur:Lerp(ss.goal, 1 - math.exp(-CFG.AimSmooth * dt)) or ss.goal
					ss.tgt.CFrame = CFrame.new(ss.cur)
					local power = 1 + (CFG.MaxPower - 1) * math.clamp((now - ss.fireAt) / CFG.PowerRamp, 0, 1)
					for _, fb in ipairs(ss.beams) do
						fb.beam.Width0, fb.beam.Width1 = fb.w0 * power, fb.w1 * power
					end
					for _, l in ipairs(ss.lights) do l.Brightness = 5 * power end
					if now - (ss.scanAt or 0) >= 0.15 then
						ss.scanAt = now
						pcall(visualBeam, ss, now)
					end
				end
			end
		end)
	end
	return s
end

local function remotePlay(pkt)
	local k = pkt.kind
	if k == "charge" then
		local s = newSession(pkt)
		if not s then return end
		for _, a in ipairs(s.eyes) do
			for _, n in ipairs(EYE_CHARGE) do table.insert(s.emitters, mkEmitter(n, a, CFG.EyeScale)) end
		end
	elseif k == "start" then
		local goal = type(pkt.d) == "table" and Fx.unvec(pkt.d.p)
		if not goal then return end
		local s = sessions[pkt.casterId]
		if not s or s.phase ~= "charge" then
			s = newSession(pkt)
		end
		if not s then return end
		for _, e in ipairs(s.emitters) do pcall(function() e.Enabled = false end) end
		s.emitters = {}
		s.phase, s.fireAt, s.last = "fire", os.clock(), os.clock()
		s.goal, s.cur = goal, goal
		s.tgt.CFrame = CFrame.new(goal)
		for _, a in ipairs(s.eyes) do
			for _, n in ipairs(EYE_FIRE) do table.insert(s.emitters, mkEmitter(n, a, CFG.EyeScale * 2)) end
			for _, b in ipairs(BEAMS) do
				local beam = Instance.new("Beam")
				beam.Texture = b.tex
				beam.TextureLength = b.len
				beam.TextureMode = b.mode
				beam.TextureSpeed = 1
				beam.Color = ColorSequence.new(b.col)
				beam.Transparency = seq(b.trans, 1)
				beam.LightEmission = 1
				beam.LightInfluence = 0
				beam.Width0 = b.w * CFG.BeamWidth * 0.5
				beam.Width1 = b.w * CFG.BeamWidth
				beam.Segments = 10
				beam.FaceCamera = true
				beam.ZOffset = b.z
				beam.Attachment0, beam.Attachment1 = a, s.endAtt
				beam.Parent = s.folder
				table.insert(s.beams, { beam = beam, w0 = beam.Width0, w1 = beam.Width1 })
			end
		end
		for _, n in ipairs(HIT_FIRE) do table.insert(s.emitters, mkEmitter(n, s.endAtt, HIT_SCALE[n] or 1)) end
		table.insert(s.emitters, mkSparks(s.endAtt))
		s.snd = playSound(SOUNDS.Fire, s.head, true)
	elseif k == "aim" then
		local s = sessions[pkt.casterId]
		local goal = s and type(pkt.d) == "table" and Fx.unvec(pkt.d.p)
		if s and goal and s.phase == "fire" then
			s.goal, s.last = goal, os.clock()
		end
	elseif k == "stop" then
		local s = sessions[pkt.casterId]
		if s then endSession(s) end
	end
end

local function remoteStop()
	for _, s in pairs(table.clone(sessions)) do
		endSession(s)
	end
	if remoteConn then
		remoteConn:Disconnect()
		remoteConn = nil
	end
end

FxSafe.register("lasereyes", { play = remotePlay, stop = remoteStop }, FX_PATH)
if VIEWER then return end

----------------------------------------------------------------------
-- Tool: equip "Laser Eyes" from your hotbar, then hold click / the on-screen LASER button (or E)
----------------------------------------------------------------------

local function startHold()
	holding = true
	task.spawn(fire)
end

local function onAction(_, state)
	if state == Enum.UserInputState.Begin then
		startHold()
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		holding = false -- ignore Change events so holding the button keeps firing
	end
	return Enum.ContextActionResult.Sink
end

local function bindButton()
	CAS:UnbindAction(ACTION)
	CAS:BindAction(ACTION, onAction, true, CFG.Key) -- true = on-screen touch button (key still works on PC)
	CAS:SetTitle(ACTION, "LASER")
	CAS:SetPosition(ACTION, UDim2.new(1, -120, 1, -220))
	local b = CAS:GetButton(ACTION)
	if b then b.Size = UDim2.fromOffset(90, 90) end
end

local function unbindButton()
	holding = false
	CAS:UnbindAction(ACTION)
end

local function makeTool()
	local t = Instance.new("Tool")
	t.Name = "Laser Eyes"
	t.ToolTip = "Hold to charge and fire"
	t.RequiresHandle = false
	t.CanBeDropped = false
	t.Activated:Connect(startHold)
	t.Deactivated:Connect(function() holding = false end)
	t.Equipped:Connect(bindButton)
	t.Unequipped:Connect(unbindButton)
	t.Destroying:Connect(unbindButton)
	return t
end

local function give()
	local bp = lp:WaitForChild("Backpack")
	if bp:FindFirstChild("Laser Eyes") or (lp.Character and lp.Character:FindFirstChild("Laser Eyes")) then return end
	makeTool().Parent = bp
end
give()
lp.CharacterAdded:Connect(function()
	unbindButton()
	task.wait(1)
	give()
end)
